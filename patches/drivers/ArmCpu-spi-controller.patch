+// Masks or unmasks an attached SPI (ICENABLER/ISENABLER, which only touch the line's own bit): the interrupt controller
+// DroidVMGicMsi keeps a vector's line attached and turns it on and off with IOInterruptController's enableVector/disableVectorHard.
+extern "C" IOReturn armcpu_spi_set_enabled (uint32_t intid, bool enabled)
+{
+  if (gDist == 0 || armcpu_gic_ready == 0) { return kIOReturnNotReady; }
+  if (intid < 32 || intid >= 1020) { return kIOReturnBadArgument; }
+  write32 (gDist, (enabled ? 0x100 : 0x180) + (intid / 32) * 4, 1U << (intid % 32));
+  return kIOReturnSuccess;
+}
