+void ArmDTPlatform::PMRegisterDevice (IOService *nub, IOService *device)
+{
+  // Preserve the bus power hierarchy so a USB port keeps its controller powered.
+  for (IOService *parent = nub; parent != nullptr; parent = parent->getProvider ()) {
+    if (parent != device && parent->inPlane (gIOPowerPlane)) {
+      parent->addPowerChild (device);
+      return;
+    }
+  }
+  IODTPlatformExpert::PMRegisterDevice (nub, device);
+}
