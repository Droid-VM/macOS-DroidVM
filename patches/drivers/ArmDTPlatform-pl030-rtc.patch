+long ArmDTPlatform::getGMTTimeOfDay (void)
+{
+  if (fRTC == nullptr) { return IODTPlatformExpert::getGMTTimeOfDay (); }
+  uint32_t seconds;
+  const uintptr_t address = fRTC->getVirtualAddress ();
+  __asm__ volatile ("ldr %w0, [%1]" : "=r" (seconds) : "r" (address) : "memory");
+  return seconds;
+}
