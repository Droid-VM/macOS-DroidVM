From c29f7c953928870ca14329e133220fde5279b6c2 Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Sat, 31 Oct 2026 06:10:02 -0400
Subject: [PATCH 39/40] k27: the Data volume at /System/Volumes/Data with
 macOS's layout and macOS's firmlinks (/private, /Applications, /Library,
 /Users, ...)

Userspace takes the mount point for the volume's identity: libsystem_coreservices' dirhelper puts NSItemReplacementDirectory items in
$TMPDIR only for paths on / or /System/Volumes/Data, else in MOUNT/.TemporaryItems, which no daemon's profile allows (trustd, locationd,
dasd, nehelper, countryd, backgroundtaskmanagementd, mds, kernelmanagerd were denied). realpath(3) turns a path naming a volume's root
into its mount point, so a firmlink to the volume's root (/private/var) broke opendirectoryd's PlistFile node (strstr of /private/var
NULL, crash loop): the Data seed now has macOS's layout (private/{var,etc,tmp}, Library, Users, ... at its root) and /private is the
firmlink, as on macOS. The staged system apps' union goes over the Data volume's Applications (the firmlink's target).

Diagnostics: k27-mkdir-log=NAME[,NAME] logs the named processes' failed mkdirs (path, error).
(cherry picked from commit de67fea49f5a94cd3d0d857f5b83168aba3c5881)
---
 bsd/kern/kern_exec.c   | 57 ++++++++++++++++++++++--------------------
 bsd/vfs/vfs_syscalls.c | 35 ++++++++++++++++++++++++++
 2 files changed, 65 insertions(+), 27 deletions(-)

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 94f8435..7de3e17 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8315,6 +8315,8 @@ native_gpu_addon_prepare(proc_t p, user_addr_t scratch)
 	    "/System/Library/LaunchDaemons/org.blu-sharky.adrenoprobed.plist", &native_gpu_addon2_stage, &native_gpu_addon2_status);
 }
 
+#define NATIVE_OWNER_DATA_POINT "/System/Volumes/Data"   /* see native_owner_firmlinks_prepare */
+
 /* The deletable system apps (Weather, Calendar, Notes, Maps, ...) ship in the OS volume's /private/var/staged_system_apps: a restore copies
  * that directory into the Data volume, and the first boot's data migration (SystemAppMigrator) installs the apps from there. An owner
  * Data seed carries no copy and marks the migration done, so with boot-arg owner-staged-apps=1 the sealed directory itself is shown as a
@@ -8330,42 +8332,44 @@ native_staged_apps_prepare(proc_t p, user_addr_t scratch)
 	if (!PE_parse_boot_argn("owner-staged-apps", &enabled, sizeof(enabled)) || enabled != 1) {
 		return;
 	}
-	static const char source[] = "/private/var/staged_system_apps", point[] = "/Applications";
-	native_gpu_addon_mount(p, scratch, 0x800, source, sizeof(source), point, sizeof(point), "/Applications/Preferences.app/Info.plist",
-	    "/Applications/Weather.app/Info.plist", &native_staged_apps_stage, &native_staged_apps_status);
+	/* k27: over the Data volume's Applications, the target of the /Applications firmlink (a mount on the firmlink's source would be
+	 * passed over), before the /private firmlink: /private/var is still the OS volume's. */
+	static const char source[] = "/private/var/staged_system_apps", point[] = NATIVE_OWNER_DATA_POINT "/Applications";
+	native_gpu_addon_mount(p, scratch, 0x800, source, sizeof(source), point, sizeof(point),
+	    NATIVE_OWNER_DATA_POINT "/Applications/Safari.app", NATIVE_OWNER_DATA_POINT "/Applications/Weather.app/Info.plist",
+	    &native_staged_apps_stage, &native_staged_apps_status);
 }
 
-/* k27 (k27-firmlinks, default on): macOS's writable root entries are firmlinks of the System volume into the Data volume; here the
- * SystemOS volume (scripts/make-macos-systemos.sh) has empty directories for them and the Data volume at /private/var keeps them under
- * .data. Set as firmlinks after the Data mount: a lookup goes on in the target (vfs_lookup.c), a path reads back with the source's,
- * and the entries stay directories (macOS 27's Sandbox profiles allow the ancestors of their paths as directories). A source that is
- * no directory (an older SystemOS disk with symbolic links) is left alone. native_owner_firmlinks has a bit per entry set. */
+/* k27: the Data volume is mounted where macOS mounts it, /System/Volumes/Data, with macOS's layout (private/var, private/etc, private/tmp,
+ * Library, Users, ...; scripts/make-macos-data-seed.sh). Userspace takes the mount point for the volume's identity: libsystem_coreservices'
+ * dirhelper puts NSItemReplacementDirectory items in $TMPDIR only for a path on "/" or "/System/Volumes/Data" (else in
+ * MOUNT/.TemporaryItems, which no daemon's Sandbox profile allows), and realpath(3) turns a path that names a volume's root into its
+ * mount point, so no firmlink may target the volume's root (opendirectoryd's PlistFile then found no "/private/var" in its node path). */
+
+/* k27 (k27-firmlinks, default on): macOS's firmlinks of the System volume into the Data volume (/usr/share/firmlinks): the SystemOS volume
+ * (scripts/make-macos-systemos.sh) has empty directories for them. Set after the Data mount: a lookup goes on in the target
+ * (vfs_lookup.c), a path reads back with the source's, and the entries stay directories (macOS 27's Sandbox profiles allow the ancestors
+ * of their paths as directories). A source that is no directory is left alone. native_owner_firmlinks has a bit per entry set. Off,
+ * nothing under /private, /Library, /Users, ... is reachable. */
 static TUNABLE(bool, k27_firmlinks, "k27-firmlinks", true);
 volatile uint32_t native_owner_firmlinks = 0;
 static void
 native_owner_firmlinks_prepare(void)
 {
-	static const char *const links[][2] = {
-		{"/Applications", "/private/var/.data/Applications"},
-		{"/Library", "/private/var/.data/Library"},
-		{"/Users", "/private/var/.data/Users"},
-		{"/Volumes", "/private/var/.data/Volumes"},
-		{"/cores", "/private/var/.data/cores"},
-		{"/opt", "/private/var/.data/opt"},
-		{"/usr/local", "/private/var/.data/usr/local"},
-		{"/System/Library/Caches", "/private/var/.data/System/Library/Caches"},
-		{"/System/Volumes/Hardware", "/private/var/.data/System/Volumes/Hardware"},
-		{"/private/etc", "/private/var/.data/private/etc"},
-		{"/private/tmp", "/private/var/tmp"},
+	static const char *const links[] = {
+		"/private", "/Applications", "/Library", "/Users", "/Volumes", "/cores", "/opt", "/usr/local", "/System/Library/Caches",
+		"/System/Volumes/Hardware",
 	};
 	if (!k27_firmlinks) {
 		return;
 	}
 	for (unsigned i = 0; i < sizeof(links) / sizeof(links[0]); i++) {
+		char target_path[MAXPATHLEN];
 		vnode_t source = NULLVP, target = NULLVP;
-		int error = vnode_lookup(links[i][0], 0, &source, vfs_context_current());
+		snprintf(target_path, sizeof(target_path), NATIVE_OWNER_DATA_POINT "%s", links[i]);
+		int error = vnode_lookup(links[i], 0, &source, vfs_context_current());
 		if (!error) {
-			error = vnode_vtype(source) == VDIR ? vnode_lookup(links[i][1], 0, &target, vfs_context_current()) : ENOTDIR;
+			error = vnode_vtype(source) == VDIR ? vnode_lookup(target_path, 0, &target, vfs_context_current()) : ENOTDIR;
 		}
 		if (!error) {
 			error = vnode_vtype(target) == VDIR && vnode_mount(target) != vnode_mount(source) ? 0 : ENOTDIR;
@@ -8376,7 +8380,7 @@ native_owner_firmlinks_prepare(void)
 		if (!error) {
 			native_owner_firmlinks |= 1u << i;
 		}
-		printf("k27: firmlink %s -> %s: %d\n", links[i][0], links[i][1], error);
+		printf("k27: firmlink %s -> %s: %d\n", links[i], target_path, error);
 		if (target) vnode_put(target);
 		if (source) vnode_put(source);
 	}
@@ -8422,16 +8426,14 @@ native_owner_data_prepare(proc_t p, user_addr_t scratch)
 	    .flags = 0, .data = scratch + 0x200};
 	int32_t result = 0;
 	if ((error = copyout("apfs", request.type, 5)) ||
-	    (error = copyout("/private/var", request.path, 13)) ||
+	    (error = copyout(NATIVE_OWNER_DATA_POINT, request.path, sizeof(NATIVE_OWNER_DATA_POINT))) ||
 	    (error = copyout(device_path, spec, strlen(device_path) + 1)) ||
 	    (error = copyout(payload, request.data, sizeof(payload)))) goto done;
-	/* still the OS volume's /private/var */
-	native_staged_apps_prepare(p, scratch);
 	native_owner_data_stage = 2;
 	error = mount(p, &request, &result);
 	if (error) goto done;
 	native_owner_data_stage = 3;
-	error = vnode_lookup("/private/var", 0, &data_root, vfs_context_current());
+	error = vnode_lookup(NATIVE_OWNER_DATA_POINT, 0, &data_root, vfs_context_current());
 	if (error) goto done;
 	mount_t data_mount = vnode_mount(data_root);
 	vnode_t device_node = vfs_devvp(data_mount);
@@ -8442,6 +8444,7 @@ native_owner_data_prepare(proc_t p, user_addr_t scratch)
 	if (actual != device || (vfs_flags(data_mount) & MNT_RDONLY) ||
 	    strcmp(vfs_statfs(data_mount)->f_fstypename, "apfs")) error = EINVAL;
 	if (!error) native_owner_data_stage = 4;
+	if (!error) native_staged_apps_prepare(p, scratch);   /* /private/var is still the OS volume's */
 	if (!error) native_owner_firmlinks_prepare();
 	if (!error) native_gpu_addon_prepare(p, scratch);
 done:
diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
index d63b482..14eb076 100644
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -10475,6 +10475,38 @@ renameat(__unused proc_t p, struct renameat_args *uap, __unused int32_t *retval)
 	           uap->tofd, uap->to, UIO_USERSPACE, 0);
 }
 
+/* k27 diagnostics (k27-mkdir-log=NAME[,NAME]): a failed mkdir of the named processes logs its path and error. */
+static void
+k27_mkdir_log(user_addr_t path, int error)
+{
+	static char names[64];
+	static int parsed = -1;
+	if (parsed < 0) {
+		parsed = PE_parse_boot_arg_str("k27-mkdir-log", names, sizeof(names)) ? 1 : 0;
+	}
+	if (!parsed) {
+		return;
+	}
+	const char *me = proc_best_name(current_proc());
+	size_t len = strlen(me);
+	for (const char *n = names; *n;) {
+		const char *end = strchr(n, ',');
+		if (end == NULL) {
+			end = n + strlen(n);
+		}
+		if ((size_t)(end - n) == len && !strncmp(n, me, len)) {
+			char buf[MAXPATHLEN];
+			size_t copied = 0;
+			if (copyinstr(path, buf, sizeof(buf), &copied)) {
+				strlcpy(buf, "?", sizeof(buf));
+			}
+			printf("k27-mkdir: %s[%d] %s: %d\n", me, proc_selfpid(), buf, error);
+			return;
+		}
+		n = *end ? end + 1 : end;
+	}
+}
+
 /*
  * Make a directory file.
  *
@@ -10598,6 +10630,9 @@ out:
 		vnode_put(dvp);
 	}
 
+	if (error && segflg == UIO_USERSPACE) {
+		k27_mkdir_log(path, error);
+	}
 	return error;
 }
 
