diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index cafc29f..ae82fc8 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -578,22 +578,20 @@ IOGetBootManifestHash(char *hash_data, size_t *hash_data_size)
 #endif
 #include <libkern/crypto/sha2.h>
 extern "C" int native_verified_block_manifest_sha384(dev_t, const char *, uint8_t[48]);
-extern "C" int native_owner_publish_boot_manifest(dev_t, const char *, dev_t, const char *);
+extern "C" int native_owner_publish_boot_manifest(dev_t, const char *);
 extern "C" {
 volatile int native_owner_boot_manifest_status = -1;
 uint8_t native_owner_boot_manifest_hash[48];
 }
 
 extern "C" int
-native_owner_publish_boot_manifest(dev_t rootDevice, const char *rootUUID,
-    dev_t cacheDevice, const char *cacheUUID)
+native_owner_publish_boot_manifest(dev_t rootDevice, const char *rootUUID)
 {
 	static const char domain[] = "VerifiedRoot.OwnerBootSet.v1";
-	uint8_t rootDigest[48], cacheDigest[48], digest[48];
-	uint8_t rootRole = 1, cacheRole = 2;
-	if (rootDevice == cacheDevice ||
-	    !native_verified_block_manifest_sha384(rootDevice, rootUUID, rootDigest) ||
-	    !native_verified_block_manifest_sha384(cacheDevice, cacheUUID, cacheDigest)) {
+	uint8_t rootDigest[48], digest[48];
+	uint8_t rootRole = 1;
+	// k27 single-volume layout: the set is the root alone (the System volume holds the shared cache).
+	if (!native_verified_block_manifest_sha384(rootDevice, rootUUID, rootDigest)) {
 		native_owner_boot_manifest_status = 1;
 		return 0;
 	}
@@ -602,8 +600,6 @@ native_owner_publish_boot_manifest(dev_t rootDevice, const char *rootUUID,
 	SHA384_Update(&context, domain, sizeof(domain));
 	SHA384_Update(&context, &rootRole, sizeof(rootRole));
 	SHA384_Update(&context, rootDigest, sizeof(rootDigest));
-	SHA384_Update(&context, &cacheRole, sizeof(cacheRole));
-	SHA384_Update(&context, cacheDigest, sizeof(cacheDigest));
 	SHA384_Final(digest, &context);
 	IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
 	if (!chosen) { native_owner_boot_manifest_status = 2; return 0; }
@@ -1951,48 +1947,3 @@ IOVnodeGetEntitlement(vnode_t vnode, int64_t off, const char *entitlement)
 	return value;
 }
 
-#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
-/*
- * port: the IOMedia whose UUID property is UUID (an APFS volume), as the device the owner chain mounts: its dev_t and /dev path.
- * (kern_exec.c native_owner_cache_prepare; the verified block driver provides this in the fork's own builds.)
- */
-extern "C" int
-native_verified_block_volume_device(const char *uuid, dev_t *device, char *path, size_t length)
-{
-	OSDictionary *match = IOService::serviceMatching("IOMedia");
-	OSDictionary *properties = OSDictionary::withCapacity(1);
-	OSString *value = OSString::withCString(uuid);
-	int found = 0;
-
-	if (match == NULL || properties == NULL || value == NULL) {
-		goto done;
-	}
-	properties->setObject("UUID", value);
-	match->setObject(gIOPropertyMatchKey, properties);
-	{
-		IOService *media = IOService::waitForMatchingService(match, 60ULL * NSEC_PER_SEC);
-		if (media != NULL) {
-			OSString *name = OSDynamicCast(OSString, media->getProperty(kIOBSDNameKey));
-			OSNumber *major = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMajorKey));
-			OSNumber *minor = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMinorKey));
-			if (name != NULL && major != NULL && minor != NULL) {
-				snprintf(path, length, "/dev/%s", name->getCStringNoCopy());
-				*device = makedev(major->unsigned32BitValue(), minor->unsigned32BitValue());
-				found = 1;
-			}
-			media->release();
-		}
-	}
-done:
-	if (value) {
-		value->release();
-	}
-	if (properties) {
-		properties->release();
-	}
-	if (match) {
-		match->release();
-	}
-	return found;
-}
-#endif
