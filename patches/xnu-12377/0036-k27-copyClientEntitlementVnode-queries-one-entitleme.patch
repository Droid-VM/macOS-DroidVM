From 40d4c0526511849d9b4c0059b4c1df90cb9de444 Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Fri, 30 Oct 2026 03:46:51 -0400
Subject: [PATCH 36/48] k27: copyClientEntitlementVnode queries one entitlement
 through AMFI (27's AMFI panics copying the whole dictionary)

---
 iokit/Kernel/IOUserClient.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
index 5e2ef5c..d1eb888 100644
--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -1613,6 +1613,20 @@ IOUserClient::copyClientEntitlementVnode(
 	OSDictionary *entitlements;
 	OSObject *value;
 
+	/*
+	 * k27: one entitlement through AMFI's query (copyEntitlementAsOSObject) rather than a copy of the whole dictionary: macOS 27's
+	 * AMFI panics ("failed to create OSDictionary copy: 14", OSEntitlements::copyDictionary) on the spawns of launchd.
+	 */
+	struct cs_blob *blob = csvnode_get_blob(vnode, offset);
+	void *osEntitlements = blob ? csblob_os_entitlements_get(blob) : NULL;
+	if (osEntitlements) {
+		void *object = NULL;
+		if (amfi->OSEntitlements.copyEntitlementAsOSObject(osEntitlements, entitlement, &object) != KERN_SUCCESS) {
+			return NULL;
+		}
+		return (OSObject *)object;
+	}
+
 	entitlements = copyClientEntitlementsVnode(vnode, offset);
 	if (entitlements == NULL) {
 		return NULL;
