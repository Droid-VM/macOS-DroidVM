From 27d3e2f4904cca893ace8c1a87491113501e4efe Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Sat, 7 Nov 2026 01:04:03 -0500
Subject: [PATCH 42/49] k27: the OS and SystemOS volume UUIDs come from the
 boot, not the source

The owner boot manifest (kern_exec.c) named the macOS 27.0.1 OS volume (C73696D4-...) and the SystemOS volume (8846FE78-...)
as constants, so another OS image needed a kernel change.

native_owner_root_volume_uuid() reads the mounted root's volume UUID (vfs_getattr f_uuid, as imageboot's set_fake_bootuuid);
native_owner_systemos_volume_uuid() reads /chosen/owner-systemos-uuid, which scripts/run-macos-vm.py takes from the SystemOS image.
---
 bsd/kern/kern_exec.c | 25 +++++++++++++++++++++----
 1 file changed, 21 insertions(+), 4 deletions(-)

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 8dba649..16fc882 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8091,10 +8091,25 @@ native_owner_cache_checkpoint(int status, int authorized)
 	__asm__ volatile("" : : "r"(status), "r"(authorized) : "memory");
 }
 
+/* The volume UUID of the mounted OS root, as text: the kernel follows whichever OS image it was booted from. */
+int native_owner_root_volume_uuid(mount_t, uuid_string_t);
+int
+native_owner_root_volume_uuid(mount_t mp, uuid_string_t text)
+{
+	struct vfs_attr va;
+	VFSATTR_INIT(&va);
+	VFSATTR_WANTED(&va, f_uuid);
+	if (!mp || vfs_getattr(mp, &va, vfs_context_current()) || !VFSATTR_IS_SUPPORTED(&va, f_uuid)) {
+		return 0;
+	}
+	uuid_unparse_upper(va.f_uuid, text);
+	return 1;
+}
+
 static int
 native_owner_cache_prepare(proc_t p, user_addr_t scratch, user_addr_t *envp)
 {
-	const char *volume = "8846FE78-2910-4297-AF97-D59BB6F8FC16";
+	uuid_string_t volume;
 #if defined(XNU_OWNER_UNION_SYSTEMOS) && XNU_OWNER_UNION_SYSTEMOS
 #if !CONFIG_UNION_MOUNTS
 #error The owner composition requires the original native union-mount implementation
@@ -8140,7 +8155,8 @@ native_owner_cache_prepare(proc_t p, user_addr_t scratch, user_addr_t *envp)
 	    native_verified_block_root_authorized(root_device);
 	if (!root_authorized) goto done;
 	native_owner_cache_stage = 1;
-	if (!native_verified_block_volume_device(volume, &selected, device_path,
+	if (!native_owner_systemos_volume_uuid(volume) ||
+	    !native_verified_block_volume_device(volume, &selected, device_path,
 	    sizeof(device_path))) goto done;
 	strlcpy(native_owner_cache_device_path, device_path, sizeof(native_owner_cache_device_path));
 	native_owner_cache_selected_device = selected;
@@ -8198,9 +8214,10 @@ done:
 	native_owner_cache_root_recheck = root_recheck;
 	if (!root_recheck) error = EAUTH;
 #if defined(XNU_OWNER_BOOT_MANIFEST) && XNU_OWNER_BOOT_MANIFEST
+	uuid_string_t root_uuid;
 	if (!error && cache_authorized && root_recheck &&
-	    !native_owner_publish_boot_manifest(root_device, "C73696D4-CAC4-40A0-90CB-7D0463E4E3E6",
-	        selected, volume)) error = EAUTH;
+	    (!native_owner_root_volume_uuid(root_mount, root_uuid) ||
+	    !native_owner_publish_boot_manifest(root_device, root_uuid, selected, volume))) error = EAUTH;
 #endif
 #if defined(XNU_OWNER_CACHE_STARTUP) && XNU_OWNER_CACHE_STARTUP
 	if (!error && cache_authorized && root_recheck) {
