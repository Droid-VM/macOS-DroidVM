diff --git a/osfmk/kern/kern_stackshot.c b/osfmk/kern/kern_stackshot.c
index 970a39a..fd92243 100644
--- a/osfmk/kern/kern_stackshot.c
+++ b/osfmk/kern/kern_stackshot.c
@@ -6528,3 +6528,128 @@ stackshot_update_passcode_status(stackshot_passcode_status_t primary_user_status
 {
 	passcode_status = primary_user_status;
 }
+
+/*
+ * Virtual machine boards: periodic stackshot to the serial console. boot-arg stackshot-dump=<seconds> takes the first
+ * stackshot (all tasks, user and kernel stacks, wait owners, image load info) that many seconds after boot and again
+ * every stackshot-dump-period=<seconds> (0: only once), printed straight to PE_kputc (kprintf is off on RELEASE) as
+ * base64 lines "SSHOT <seq> <offset> <total> <sum> <data>" for tools/lldbmacros/kcdata.py on the host.
+ */
+#include <kern/kalloc.h>
+#include <kern/startup.h>
+#include <kern/thread_call.h>
+#include <stdarg.h>
+
+extern int vsnprintf(char *, size_t, const char *, va_list);
+
+#define VIRT_STACKSHOT_SIZE (4U * 1024U * 1024U)
+#define VIRT_STACKSHOT_LINE 48U
+
+static thread_call_t virt_stackshot_call;
+static uint32_t virt_stackshot_period;
+static uint32_t virt_stackshot_seq;
+static void *virt_stackshot_buffer;
+
+static void __printflike(1, 2)
+virt_stackshot_line(const char *fmt, ...)
+{
+	char line[128];
+	va_list args;
+	boolean_t state;
+	int length;
+
+	va_start(args, fmt);
+	length = vsnprintf(line, sizeof(line), fmt, args);
+	va_end(args);
+	length = MIN(length, (int)sizeof(line) - 1);
+	state = ml_set_interrupts_enabled(FALSE);
+	for (int i = 0; i < length; i++) {
+		PE_kputc(line[i]);
+	}
+	ml_set_interrupts_enabled(state);
+}
+
+static void
+virt_stackshot_arm(uint32_t seconds)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(seconds, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(virt_stackshot_call, deadline);
+}
+
+static void
+virt_stackshot_print(const uint8_t *data, uint32_t total, uint32_t seq)
+{
+	static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	char line[VIRT_STACKSHOT_LINE / 3 * 4 + 1];
+
+	for (uint32_t offset = 0; offset < total; offset += VIRT_STACKSHOT_LINE) {
+		uint32_t length = MIN(VIRT_STACKSHOT_LINE, total - offset);
+		uint32_t sum = 0;
+		uint32_t out = 0;
+
+		for (uint32_t i = 0; i < length; i += 3) {
+			uint32_t word = (uint32_t)data[offset + i] << 16;
+			uint32_t count = MIN(3U, length - i);
+
+			if (count > 1) {
+				word |= (uint32_t)data[offset + i + 1] << 8;
+			}
+			if (count > 2) {
+				word |= data[offset + i + 2];
+			}
+			line[out++] = alphabet[(word >> 18) & 0x3f];
+			line[out++] = alphabet[(word >> 12) & 0x3f];
+			line[out++] = count > 1 ? alphabet[(word >> 6) & 0x3f] : '=';
+			line[out++] = count > 2 ? alphabet[word & 0x3f] : '=';
+		}
+		line[out] = '\0';
+		for (uint32_t i = 0; i < length; i++) {
+			sum = (sum * 31U + data[offset + i]) & 0xffffffU;
+		}
+		virt_stackshot_line("SSHOT %u %x %x %06x %s\n", seq, offset, total, sum, line);
+	}
+}
+
+static void
+virt_stackshot_run(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t flags = STACKSHOT_KCDATA_FORMAT | STACKSHOT_SAVE_LOADINFO | STACKSHOT_SAVE_KEXT_LOADINFO |
+	    STACKSHOT_THREAD_WAITINFO | STACKSHOT_GET_DQ | STACKSHOT_NO_IO_STATS | STACKSHOT_SKIP_EXCLAVES;
+	uint32_t seq = virt_stackshot_seq++;
+	unsigned bytes = 0;
+	kern_return_t kr;
+
+	if (virt_stackshot_buffer == NULL) {
+		virt_stackshot_buffer = kalloc_data(VIRT_STACKSHOT_SIZE, Z_WAITOK | Z_ZERO);
+	}
+	if (virt_stackshot_buffer == NULL) {
+		virt_stackshot_line("SSHOT %u: no buffer\n", seq);
+		return;
+	}
+	kr = stack_snapshot_from_kernel(-1, virt_stackshot_buffer, VIRT_STACKSHOT_SIZE, flags, 0, 0, &bytes);
+	virt_stackshot_line("SSHOT %u begin: kr %d, %u bytes\n", seq, kr, bytes);
+	if (kr == KERN_SUCCESS && bytes != 0) {
+		virt_stackshot_print(virt_stackshot_buffer, bytes, seq);
+	}
+	virt_stackshot_line("SSHOT %u end\n", seq);
+	if (virt_stackshot_period != 0) {
+		virt_stackshot_arm(virt_stackshot_period);
+	}
+}
+
+static void
+virt_stackshot_init(void)
+{
+	uint32_t first = 0;
+
+	if (!PE_parse_boot_argn("stackshot-dump", &first, sizeof(first)) || first == 0) {
+		return;
+	}
+	PE_parse_boot_argn("stackshot-dump-period", &virt_stackshot_period, sizeof(virt_stackshot_period));
+	virt_stackshot_call = thread_call_allocate_with_options(virt_stackshot_run, NULL,
+	    THREAD_CALL_PRIORITY_KERNEL, THREAD_CALL_OPTIONS_ONCE);
+	virt_stackshot_arm(first);
+}
+STARTUP(THREAD_CALL, STARTUP_RANK_LAST, virt_stackshot_init);
