+#include <stdint.h>
+
+/* The C++ static destructors in the kernel never run. */
+int
+__cxa_atexit(void (*func)(void *), void *arg, void *dso)
+{
+	(void)func; (void)arg; (void)dso;
+	return 0;
+}
+
+/* The virtual machine is never an engineering-fused device. */
+boolean_t
+ml_device_is_prod_fused(void)
