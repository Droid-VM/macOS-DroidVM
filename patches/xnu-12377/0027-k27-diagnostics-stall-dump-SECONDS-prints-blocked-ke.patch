From b97e38d971596d9ce582cc3757120d1bb3e462e0 Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Fri, 30 Oct 2026 02:31:59 -0400
Subject: [PATCH 27/49] k27 diagnostics: stall-dump=SECONDS prints blocked
 kernel threads' backtraces while launchd has not started

(cherry picked from commit 74c0458928411f176aade76cb2871cf047a4bff0)
---
 osfmk/conf/files       |  1 +
 osfmk/kern/k27_stall.c | 83 ++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 84 insertions(+)
 create mode 100644 osfmk/kern/k27_stall.c

diff --git a/osfmk/conf/files b/osfmk/conf/files
index be537d4..95f9d89 100644
--- a/osfmk/conf/files
+++ b/osfmk/conf/files
@@ -202,6 +202,7 @@ osfmk/kern/test_mpsc_queue.c	optional debug
 osfmk/kern/thread.c			standard
 osfmk/kern/thread_act.c		standard
 osfmk/kern/thread_call.c	standard
+osfmk/kern/k27_stall.c		standard
 osfmk/kern/thread_group.c	standard
 osfmk/kern/thread_policy.c	standard
 osfmk/kern/thread_test_context.c	optional development
diff --git a/osfmk/kern/k27_stall.c b/osfmk/kern/k27_stall.c
new file mode 100644
index 0000000..36cdbf2
--- /dev/null
+++ b/osfmk/kern/k27_stall.c
@@ -0,0 +1,83 @@
+/*
+ * k27 diagnostics: stall-dump=SECONDS. If launchd has not started that long after boot, print the kernel backtrace of every blocked
+ * thread to the message buffer ("k27-stall:" lines, frame return addresses), once; then again every SECONDS while it still has not.
+ * Symbolize with the kernel's nm (out/rig/kc-k27.nm) and the kernel collection's kext symbols.
+ */
+#include <kern/thread.h>
+#include <kern/task.h>
+#include <kern/processor.h>
+#include <kern/startup.h>
+#include <kern/thread_call.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/zalloc.h>
+#include <ptrauth.h>
+
+extern void *initproc;
+extern lck_mtx_t tasks_threads_lock;
+
+static TUNABLE(uint32_t, k27_stall_seconds, "stall-dump", 0);
+
+static void k27_stall_check(thread_call_param_t, thread_call_param_t);
+
+static void
+k27_stall_arm(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(k27_stall_seconds, NSEC_PER_SEC, &deadline);
+	thread_call_func_delayed(k27_stall_check, NULL, deadline);
+}
+
+static void
+k27_stall_check(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	if (initproc != NULL) {
+		return;
+	}
+	printf("k27-stall: no launchd after %u s, blocked threads:\n", k27_stall_seconds);
+	thread_t thread;
+	lck_mtx_lock(&tasks_threads_lock);
+	queue_iterate(&threads, thread, thread_t, threads) {
+		if (thread->wait_event == 0 || thread == current_thread()) {
+			continue;
+		}
+		vm_offset_t stack = thread->kernel_stack;
+		arm_kernel_saved_state_t *state = (arm_kernel_saved_state_t *)thread->machine.kstackptr;
+		if (stack == 0 || state == NULL) {
+			continue;
+		}
+		uint64_t frames[16];
+		unsigned int count = 0;
+		frames[count++] = (uint64_t)ptrauth_strip((void *)state->lr, ptrauth_key_return_address);
+		uint64_t fp = state->fp;
+		while (count < 16 && fp >= stack && fp + 16 <= stack + kernel_stack_size && (fp & 7) == 0) {
+			uint64_t lr = ((uint64_t *)fp)[1];
+			uint64_t next = ((uint64_t *)fp)[0];
+			if (lr == 0) {
+				break;
+			}
+			frames[count++] = (uint64_t)ptrauth_strip((void *)lr, ptrauth_key_return_address);
+			if (next <= fp) {
+				break;
+			}
+			fp = next;
+		}
+		printf("k27-stall: tid %llu task %p event %p:", thread_tid(thread), get_threadtask(thread), (void *)VM_KERNEL_UNSLIDE_OR_PERM(thread->wait_event));
+		for (unsigned int i = 0; i < count; i++) {
+			printf(" %llx", frames[i]);
+		}
+		printf("\n");
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+	k27_stall_arm();
+}
+
+__startup_func
+static void
+k27_stall_init(void)
+{
+	if (k27_stall_seconds) {
+		k27_stall_arm();
+	}
+}
+STARTUP(THREAD_CALL, STARTUP_RANK_LAST, k27_stall_init);
