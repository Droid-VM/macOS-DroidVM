diff --git a/EXTERNAL_HEADERS/CoreEntitlements/V2/API.h b/EXTERNAL_HEADERS/CoreEntitlements/V2/API.h
deleted file mode 100644
index 22aa695..0000000
--- a/EXTERNAL_HEADERS/CoreEntitlements/V2/API.h
+++ /dev/null
@@ -1,51 +0,0 @@
-/*
- * Compile-only stand-in for Apple's private CoreEntitlements V2 kernel API header.
- * The real header is not published; this declares just what xnu-12377 uses. The layout of
- * CEKernelAPI_t is NOT the real one, so a native AMFI kext cannot be handed this table as is.
- */
-#ifndef _CE_V2_API_H
-#define _CE_V2_API_H
-
-#include <stdbool.h>
-#include <stddef.h>
-#include <stdint.h>
-#include <CoreEntitlements/CoreEntitlements.h>
-
-typedef int CEReturn_t;
-enum {
-	kCEReturnSuccess = 0,
-	kCEReturnError = 1,
-	kCEReturnV1NotEligibleForAcceleration = 2,
-};
-
-typedef struct {
-	const uint8_t *data;
-	size_t length;
-} CEBuffer_t;
-
-typedef struct {
-	uint64_t opaque[4];
-} CEElement_t;
-
-typedef struct {
-	uint64_t opaque[16];
-} CEContext_t;
-
-typedef enum {
-	kCEContextTypeProvisioningProfile = 1,
-	kCEContextTypeProvisioningProfileEntitlements = 2,
-} CEContextType_t;
-
-typedef struct {
-	CEReturn_t (*contextValueForKey)(const CEContext_t *ctx, const char *key, CEElement_t *value);
-	CEReturn_t (*elementMatchBool)(const CEElement_t *element, bool value);
-	CEReturn_t (*elementGetCEBuffer)(const CEElement_t *element, CEBuffer_t *buffer);
-	CEReturn_t (*contextInitWithTypeLegacy)(const CERuntime_t rt, CEContextType_t type,
-	    CEContext_t *ctx, const uint8_t *data, size_t length);
-	CEReturn_t (*contextCheckAcceleration)(const CEContext_t *ctx);
-	CEReturn_t (*contextEvaluateAcceleration)(const CEContext_t *ctx, size_t *length);
-	CEReturn_t (*contextAccelerate)(CEContext_t *ctx);
-	CEReturn_t (*contextGetLegacyContext)(const CEContext_t *ctx, CEQueryContext_t *legacy);
-} CEKernelAPI_t;
-
-#endif
