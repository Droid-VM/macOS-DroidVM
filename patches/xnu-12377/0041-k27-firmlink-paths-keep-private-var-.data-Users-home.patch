From fde0a17b9a501b16a8b2a8079aacc6ac857af3c3 Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Fri, 30 Oct 2026 05:42:43 -0400
Subject: [PATCH 41/48] k27-firmlink-paths: keep /private/var/.data/Users (home
 rules come from realpath'd HOME_DIR)

---
 bsd/vfs/vfs_cache.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/bsd/vfs/vfs_cache.c b/bsd/vfs/vfs_cache.c
index be2feb0..715bf70 100644
--- a/bsd/vfs/vfs_cache.c
+++ b/bsd/vfs/vfs_cache.c
@@ -520,6 +520,16 @@ static int build_path_with_parent_raw(vnode_t, vnode_t, char *, int, int *, size
  */
 static TUNABLE(bool, k27_firmlink_paths, "k27-firmlink-paths", true);
 
+/*
+ * Except /Users: the profiles name homes through their HOME_DIR parameters, which userspace makes with realpath(3), and realpath
+ * follows the system volume's /Users link (macOS's firmlink stays /Users), so the rules read /private/var/.data/Users/NAME/...
+ */
+static bool
+k27_firmlink_keeps(const char *rest)
+{
+	return strncmp(rest, "/Users", 6) == 0 && (rest[6] == '/' || rest[6] == '\0');
+}
+
 int
 build_path_with_parent(vnode_t first_vp, vnode_t parent_vp, char *buff, int buflen,
     int *outlen, size_t *mntpt_outlen, int flags, vfs_context_t ctx)
@@ -528,7 +538,7 @@ build_path_with_parent(vnode_t first_vp, vnode_t parent_vp, char *buff, int bufl
 	const size_t plen = sizeof(prefix) - 1;
 	int ret = build_path_with_parent_raw(first_vp, parent_vp, buff, buflen, outlen, mntpt_outlen, flags, ctx);
 	if (ret == 0 && k27_firmlink_paths && !(flags & BUILDPATH_NO_FIRMLINK) &&
-	    *outlen > (int)plen + 1 && strncmp(buff, prefix, plen) == 0 && buff[plen] == '/') {
+	    *outlen > (int)plen + 1 && strncmp(buff, prefix, plen) == 0 && buff[plen] == '/' && !k27_firmlink_keeps(buff + plen)) {
 		memmove(buff, buff + plen, (size_t)*outlen - plen);
 		*outlen -= (int)plen;
 		if (mntpt_outlen) {
