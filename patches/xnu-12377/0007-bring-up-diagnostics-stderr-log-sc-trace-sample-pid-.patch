 	const_boot_args = *args;
diff --git a/osfmk/arm64/locore.s b/osfmk/arm64/locore.s
index 3f42af8..fd736d1 100644
--- a/osfmk/arm64/locore.s
+++ b/osfmk/arm64/locore.s
@@ -834,6 +834,19 @@ Lel1_sp1_synchronous_vector_continue:
 LEXT(el1_sp1_synchronous_vector_long_spill_failed)
 	TRAP_UNWIND_PROLOGUE
 	TRAP_UNWIND_DIRECTIVES
+	/* port bring-up: record ESR/ELR/FAR/SP of the fault we could not spill */
+	adrp	x0, EXT(port_exc)@page
+	add		x0, x0, EXT(port_exc)@pageoff
+	mrs		x1, ESR_EL1
+	str		x1, [x0]
+	mrs		x1, ELR_EL1
+	str		x1, [x0, #8]
+	mrs		x1, FAR_EL1
+	str		x1, [x0, #16]
+	mov		x1, sp
+	str		x1, [x0, #24]
+	mov		x1, #1
+	str		x1, [x0, #32]
 	/*
 	 * We couldn't process the exception due to either having an invalid
 	 * exception stack or because we previously tried to process it and failed.
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index d2f978a..d5c25f1 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -194,6 +194,33 @@ virt_crash_log_thread(exception_type_t exception, mach_exception_data_t code, ma
 		    (unsigned long long)get_saved_state_pc(state), (unsigned long long)get_saved_state_lr(state),
 		    (unsigned long long)get_saved_state_sp(state), (unsigned long long)get_saved_state_fp(state),
 		    (unsigned long long)get_saved_state_far(state), get_saved_state_esr(state));
+		for (unsigned int r = 0; r < 29; r += 4) {
+			printf("crash: pid %d x%u 0x%llx 0x%llx 0x%llx 0x%llx\n", pid, r, (unsigned long long)get_saved_state_reg(state, r),
+			    (unsigned long long)get_saved_state_reg(state, r + 1), (unsigned long long)get_saved_state_reg(state, r + 2),
+			    r + 3 < 29 ? (unsigned long long)get_saved_state_reg(state, r + 3) : 0ULL);
+		}
+		{
+			static const unsigned int dump_regs[] = {19, 0};
+			for (unsigned int d = 0; d < 2; d++) {
+				uint64_t address = get_saved_state_reg(state, dump_regs[d]) & 0xfffffffffULL;
+				uint64_t words[8];
+				if (copyin(address, words, sizeof(words)) == 0) {
+					printf("crash: pid %d mem x%u 0x%llx: %llx %llx %llx %llx %llx %llx %llx %llx\n", pid, dump_regs[d],
+					    (unsigned long long)address, (unsigned long long)words[0], (unsigned long long)words[1],
+					    (unsigned long long)words[2], (unsigned long long)words[3], (unsigned long long)words[4],
+					    (unsigned long long)words[5], (unsigned long long)words[6], (unsigned long long)words[7]);
+				} else {
+					printf("crash: pid %d mem x%u 0x%llx unreadable\n", pid, dump_regs[d], (unsigned long long)address);
+				}
+			}
+		}
+		extern uint64_t virt_region_path(task_t, uint64_t, char *, int, uint64_t *);
+		static char path[160];
+		uint64_t size, start;
+		start = virt_region_path(task, get_saved_state_pc(state), path, sizeof(path), &size);
+		printf("crash: pid %d pc in 0x%llx+0x%llx %s\n", pid, (unsigned long long)start, (unsigned long long)size, path);
+		start = virt_region_path(task, get_saved_state_lr(state), path, sizeof(path), &size);
+		printf("crash: pid %d lr in 0x%llx+0x%llx %s\n", pid, (unsigned long long)start, (unsigned long long)size, path);
 	}
 	count = backtrace_user(frames, VIRT_CRASH_FRAMES, NULL, &info);
 	for (unsigned int i = 0; i < count; i += 4) {
@@ -204,6 +231,106 @@ virt_crash_log_thread(exception_type_t exception, mach_exception_data_t code, ma
 		printf("crash: pid %d backtrace error %d after %u frames\n", pid, info.btui_error, count);
 	}
 }
+
+/*
+ * Virtual machine boards: boot-arg sample-pid=<pid> [sample-period=<seconds>] prints, every period, one line per thread of that
+ * process (state, wait event, user pc/lr/sp/fp) to the message buffer: where a stuck launchd is waiting.
+ */
+#include <kern/thread_call.h>
+#include <kern/queue.h>
+extern void *proc_find(int pid);
+extern void proc_rele(void *p);
+extern task_t proc_task(void *p);
+extern const char *virt_thread_wmesg(thread_t);
+extern uint64_t virt_region_path(task_t, uint64_t, char *, int, uint64_t *);
+
+static TUNABLE(int, virt_sample_pid, "sample-pid", 0);
+static TUNABLE(uint32_t, virt_sample_period, "sample-period", 5);
+static thread_call_t virt_sample_call;
+
+static void
+virt_sample_run(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	void *proc = virt_sample_pid > 0 ? proc_find(virt_sample_pid) : NULL;
+	if (proc != NULL || virt_sample_pid < 0) {
+		task_t task = proc != NULL ? proc_task(proc) : kernel_task;
+		thread_t thread;
+		static struct {
+			uint64_t tid, pc, lr, sp, fp, wait;
+			uint64_t kframes[16];
+			unsigned int kcount;
+			uint32_t state;
+			int pri;
+			const char *msg;
+		} seen[128];
+		unsigned int n = 0, total = 0;
+
+		task_lock(task);
+		queue_iterate(&task->threads, thread, thread_t, task_threads) {
+			struct arm_saved_state *state = find_user_regs(thread);
+			total++;
+			if (n < 128) {
+				seen[n].tid = thread_tid(thread);
+				seen[n].state = thread->state;
+				seen[n].wait = (uint64_t)thread->wait_event;
+				seen[n].pri = thread->sched_pri;
+				seen[n].msg = virt_thread_wmesg(thread);
+				seen[n].pc = state ? get_saved_state_pc(state) : 0;
+				seen[n].lr = state ? get_saved_state_lr(state) : 0;
+				seen[n].sp = state ? get_saved_state_sp(state) : 0;
+				seen[n].fp = state ? get_saved_state_fp(state) : 0;
+				seen[n].kcount = 0;
+				if ((thread->state & TH_RUN) == 0 && thread->kernel_stack != 0 && thread->machine.kstackptr != NULL) {
+					struct arm_kernel_saved_state *ks = (struct arm_kernel_saved_state *)thread->machine.kstackptr;
+					uint64_t fp = ks->fp;
+					seen[n].kframes[seen[n].kcount++] = VM_KERNEL_STRIP_PTR(ks->lr);
+					while (seen[n].kcount < 16 && fp >= thread->kernel_stack && fp + 16 <= thread->kernel_stack + KERNEL_STACK_SIZE && (fp & 7) == 0) {
+						seen[n].kframes[seen[n].kcount++] = VM_KERNEL_STRIP_PTR(((uint64_t *)fp)[1]);
+						fp = ((uint64_t *)fp)[0];
+					}
+				}
+				n++;
+			}
+		}
+		task_unlock(task);
+		for (unsigned int i = 0; i < n; i++) {
+			static char path[160];
+			uint64_t size, start;
+			printf("sample: pid %d tid %llu state 0x%x wait 0x%llx msg %s main 0x%llx pri %d pc 0x%llx lr 0x%llx sp 0x%llx fp 0x%llx\n",
+			    virt_sample_pid, seen[i].tid, seen[i].state, seen[i].wait, seen[i].msg, (unsigned long long)task->mach_header_vm_address,
+			    seen[i].pri, seen[i].pc, seen[i].lr, seen[i].sp, seen[i].fp);
+			for (unsigned int k = 0; k < seen[i].kcount; k++) {
+				printf("sample:   k%u 0x%llx\n", k, (unsigned long long)seen[i].kframes[k]);
+			}
+			if (seen[i].pc != 0 && task->mach_header_vm_address != 0) {
+				start = virt_region_path(task, seen[i].pc, path, sizeof(path), &size);
+				printf("sample:   pc in 0x%llx+0x%llx %s\n", (unsigned long long)start, (unsigned long long)size, path);
+				start = virt_region_path(task, seen[i].lr, path, sizeof(path), &size);
+				printf("sample:   lr in 0x%llx+0x%llx %s\n", (unsigned long long)start, (unsigned long long)size, path);
+			}
+		}
+		printf("sample: pid %d %u threads\n", virt_sample_pid, total);
+		if (proc != NULL) {
+			proc_rele(proc);
+		}
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(virt_sample_period, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(virt_sample_call, deadline);
+}
+
+__startup_func
+static void
+virt_sample_init(void)
+{
+	if (virt_sample_pid != 0) {
+		uint64_t deadline;
+		virt_sample_call = thread_call_allocate(virt_sample_run, NULL);
+		clock_interval_to_deadline(virt_sample_period, NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(virt_sample_call, deadline);
+	}
+}
+STARTUP(THREAD_CALL, STARTUP_RANK_LAST, virt_sample_init);
 #endif /* __arm64__ && MACH_BSD */
 
 /*
