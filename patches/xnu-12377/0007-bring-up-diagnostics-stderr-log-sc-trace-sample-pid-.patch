From a5477a7dfc69a24fdbb6c48446c637b224c88025 Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Sat, 24 Oct 2026 00:52:10 -0400
Subject: [PATCH 7/7] bring-up diagnostics: stderr-log, sc-trace, sample-pid
 helpers, crash-log registers, port_crumb/port_exc breadcrumbs

---
 bsd/dev/arm/systemcalls.c     |  34 +++++++++
 bsd/kern/bsd_init.c           |  35 ++++++++++
 bsd/kern/sys_generic.c        |  25 +++++++
 osfmk/arm/arm_init.c          |   3 +
 osfmk/arm64/locore.s          |  13 ++++
 osfmk/kern/exception.c        | 127 ++++++++++++++++++++++++++++++++++
 osfmk/kern/static_if_common.c |   6 ++
 7 files changed, 243 insertions(+)

diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index be208dd..30748d6 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -88,6 +88,8 @@ extern int mach_trap_count;
  * Outputs:	none
  */
 TUNABLE(bool, virt_syscall_err_log, "syscall-err-log", false);
+static char virt_sc_trace_name[96];   /* comma-separated process names */
+static int virt_sc_trace_state;   /* 0: boot-arg not read yet, 1: off, 2: on */
 
 void
 unix_syscall(
@@ -188,6 +190,38 @@ unix_syscall(
 skip_syscall:
 #endif /* CONFIG_MACF */
 
+	if (__improbable(virt_sc_trace_state != 1)) {
+		/* bring-up diagnostic (boot-arg sc-trace=<name>[,<name>...]): every failing syscall of those processes, with the path of the path-taking ones */
+		if (virt_sc_trace_state == 0) {
+			virt_sc_trace_state = PE_parse_boot_argn("sc-trace", virt_sc_trace_name, sizeof(virt_sc_trace_name)) ? 2 : 1;
+		}
+		bool virt_match = false;
+		if (virt_sc_trace_state == 2 && error != 0 && error != ERESTART && error != EJUSTRETURN && error != EWOULDBLOCK && code != 202 && code != 74 && code != 169 && code != 327 && code != 336 && code != 75 && code != 73 &&
+		    code != 92 && code != 6 && code != 25 && code != 24) {
+			/* noisy calls (sigaction/mprotect/mmap/close/...) are skipped; the list holds comma-separated names */
+			for (const char *n = virt_sc_trace_name; *n && !virt_match;) {
+				size_t l = 0;
+				while (n[l] && n[l] != ',') {
+					l++;
+				}
+				if (l && l <= 16 && strncmp(proc->p_comm, n, l) == 0 && (l == 16 || proc->p_comm[l] == 0)) {
+					virt_match = true;
+				}
+				n += l + (n[l] == ',');
+			}
+		}
+		if (virt_match) {
+			char virt_p[100] = "";
+			size_t virt_l;
+			int idx = (code == 463 || code == 470) ? 1 : 0;   /* openat, fstatat64 */
+			if (code == 5 || code == 398 || code == 463 || code == 338 || code == 340 || code == 33 || code == 58 || code == 470 ||
+			    code == 345 || code == 220 || code == 11 || code == 12 || code == 61 || code == 73) {
+				(void)copyinstr((user_addr_t)uthread->uu_arg[idx], virt_p, sizeof(virt_p), &virt_l);
+			}
+			printf("sc: %s %d err %d a0 %llx '%s'\n", proc->p_comm, code, error, (unsigned long long)uthread->uu_arg[0], virt_p);
+		}
+	}
+
 	if (__improbable(virt_syscall_err_log) && error != 0 && error != ERESTART && error != EJUSTRETURN &&
 	    error != EWOULDBLOCK && code < 1024 && error < 128) {
 		/* first failure of each (syscall, errno) pair, per boot */
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 265ef59..5362b32 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1810,3 +1810,38 @@ netboot_root(void)
 	return 0;
 }
 #endif
+
+#ifdef BCM2837
+/* port: for osfmk/kern/exception.c's sample-pid diagnostic: what a sleeping BSD thread says it waits for */
+const char *
+virt_thread_wmesg(thread_t thread)
+{
+	struct uthread *ut = get_bsdthread_info(thread);
+	return (ut != NULL && ut->uu_wmesg != NULL) ? ut->uu_wmesg : "-";
+}
+#endif
+
+#ifdef BCM2837
+#include <sys/bsdtask_info.h>
+/* port: name the file behind a user address of TASK (sample-pid diagnostic): returns the region start, fills BUF with the vnode path */
+uint64_t
+virt_region_path(task_t task, uint64_t address, char *buf, int len, uint64_t *size)
+{
+	struct proc_regioninfo_internal info;
+	uintptr_t vnodeaddr = 0;
+	uint32_t vid = 0;
+
+	buf[0] = '\0';
+	*size = 0;
+	if (fill_procregioninfo(task, address, &info, &vnodeaddr, &vid) == 0) {
+		return 0;
+	}
+	*size = info.pri_size;
+	if (vnodeaddr != 0 && vnode_getwithvid((vnode_t)vnodeaddr, vid) == 0) {
+		int l = len;
+		vn_getpath((vnode_t)vnodeaddr, buf, &l);
+		vnode_put((vnode_t)vnodeaddr);
+	}
+	return info.pri_address;
+}
+#endif
diff --git a/bsd/kern/sys_generic.c b/bsd/kern/sys_generic.c
index edac75b..edd0012 100644
--- a/bsd/kern/sys_generic.c
+++ b/bsd/kern/sys_generic.c
@@ -73,6 +73,7 @@
  */
 
 #include <sys/param.h>
+#include <pexpert/pexpert.h>
 #include <sys/systm.h>
 #include <sys/filedesc.h>
 #include <sys/ioctl.h>
@@ -700,6 +701,30 @@ write_internal(struct proc *p, int fd, user_addr_t buf, user_size_t nbyte,
 int
 write_nocancel(struct proc *p, struct write_nocancel_args *uap, user_ssize_t *retval)
 {
+#if defined(BCM2837)
+	/* bring-up diagnostic (boot-arg stderr-log=1): show what processes write to stdout/stderr (dyld and daemon error messages) */
+	{
+		static int stderr_log = -1;
+		if (stderr_log < 0) {
+			int v = 0;
+			PE_parse_boot_argn("stderr-log", &v, sizeof(v));
+			stderr_log = v ? 1 : 0;
+		}
+		if (stderr_log && (uap->fd == 1 || uap->fd == 2) && uap->nbyte) {
+			char buf[160];
+			size_t n = uap->nbyte < sizeof(buf) - 1 ? (size_t)uap->nbyte : sizeof(buf) - 1;
+			if (copyin(uap->cbuf, buf, n) == 0) {
+				for (size_t i = 0; i < n; i++) {
+					if (buf[i] == '\n' || buf[i] == '\r') {
+						buf[i] = ' ';
+					}
+				}
+				buf[n] = 0;
+				printf("fd%d: pid %d %s: %s\n", uap->fd, proc_getpid(p), p->p_comm, buf);
+			}
+		}
+	}
+#endif
 	return write_internal(p, uap->fd, uap->cbuf, uap->nbyte, (off_t)-1, 0,
 	           NULL, retval);
 }
