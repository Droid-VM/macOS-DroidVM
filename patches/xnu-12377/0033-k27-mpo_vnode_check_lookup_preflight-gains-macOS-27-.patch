From f77a1aed5528a2655a809bce94b768d843fabd3a Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Fri, 30 Oct 2026 03:38:40 -0400
Subject: [PATCH 33/40] k27: mpo_vnode_check_lookup_preflight gains macOS 27's
 int flags argument (PAC type discriminator 0x3ad2); pass 0

(cherry picked from commit 03f44346f642ef3ae934965ee1a516d56605eed4)
---
 security/mac_policy.h | 3 ++-
 security/mac_vfs.c    | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/security/mac_policy.h b/security/mac_policy.h
index d1115d9..745c37f 100644
--- a/security/mac_policy.h
+++ b/security/mac_policy.h
@@ -4458,7 +4458,8 @@ typedef int mpo_vnode_check_lookup_preflight_t(
 	struct vnode *dvp,
 	struct label *dlabel,
 	const char *path,
-	size_t pathlen
+	size_t pathlen,
+	int flags       /* k27: macOS 27 adds this (lookup flags, bits 0-4 read by its Sandbox); the PAC type discriminator follows it */
 	);
 
 /**
diff --git a/security/mac_vfs.c b/security/mac_vfs.c
index d093a7f..48e7f9f 100644
--- a/security/mac_vfs.c
+++ b/security/mac_vfs.c
@@ -1602,7 +1602,7 @@ mac_vnode_check_lookup_preflight(vfs_context_t ctx, struct vnode *dvp,
 		return 0;
 	}
 	VFS_KERNEL_DEBUG_START1(50, dvp);
-	MAC_CHECK(vnode_check_lookup_preflight, cred, dvp, mac_vnode_label(dvp), path, pathlen);
+	MAC_CHECK(vnode_check_lookup_preflight, cred, dvp, mac_vnode_label(dvp), path, pathlen, 0);
 	VFS_KERNEL_DEBUG_END1(50, dvp);
 	return error;
 }
