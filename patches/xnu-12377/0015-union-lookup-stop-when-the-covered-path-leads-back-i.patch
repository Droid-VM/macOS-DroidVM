From a9acd671308920c9a9e12fe057a16d1ea83d421c Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Sat, 24 Oct 2026 17:19:00 -0400
Subject: [PATCH 15/40] union lookup: stop when the covered path leads back
 into the union mount (SystemOS over / with the OS volume's framework links
 into /System/Cryptexes/OS: a missing name looped forever in the kernel,
 coreservicesd and every LaunchServices client hung); IOWorkLoop: every event
 source active unless kPassive when the compiler cannot resolve virtual member
 function pointers (upstream LLVM: OSMemberFunctionCast yields the virtual
 thunk, all sources compared passive, no IOInterruptEventSource ever ran)

(cherry picked from commit 4410b357a071e9a4b3b0fac653d2e7ce600d1c22)
---
 bsd/vfs/vfs_lookup.c        |  9 +++++++++
 iokit/Kernel/IOWorkLoop.cpp | 12 +++++++++++-
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/bsd/vfs/vfs_lookup.c b/bsd/vfs/vfs_lookup.c
index b897c9c..66db98b 100644
--- a/bsd/vfs/vfs_lookup.c
+++ b/bsd/vfs/vfs_lookup.c
@@ -1704,6 +1704,15 @@ lookup_error:
 		    !(ndp->ni_flag & NAMEI_NOUNION)) {
 			tdp = dp;
 			error = lookup_traverse_union(tdp, &dp, ctx);
+			if (error == 0 && dp->v_mount == tdp->v_mount) {
+				/*
+				 * The directory's path in the covered mount led back into this one (the owner chain's SystemOS volume over
+				 * the OS volume at "/": the OS volume's /System/Library/Frameworks/X.framework links to
+				 * /System/Cryptexes/OS/..., which is "/" again), so the lookup would retry the same directory forever.
+				 */
+				vnode_put(dp);
+				error = ENOENT;
+			}
 			vnode_put(tdp);
 			if (error) {
 				dp = NULLVP;
diff --git a/iokit/Kernel/IOWorkLoop.cpp b/iokit/Kernel/IOWorkLoop.cpp
index 1d93f46..e8e8de3 100644
--- a/iokit/Kernel/IOWorkLoop.cpp
+++ b/iokit/Kernel/IOWorkLoop.cpp
@@ -706,7 +706,16 @@ IOWorkLoop::eventSourcePerformsWork(IOEventSource *inEventSource)
 		result = false;
 	} else if (IOEventSource::kActive & inEventSource->flags) {
 		result = true;
-	} else if (controlG) {
+	}
+#if !__has_builtin(__builtin_load_member_function_pointer) && __has_feature(ptrauth_member_function_pointer_type_discrimination)
+	/*
+	 * Not with this compiler: without Apple clang's __builtin_load_member_function_pointer, OSMemberFunctionCast of a
+	 * virtual function is its virtual thunk, the same for every object, so every event source compared passive and an
+	 * IOInterruptEventSource never ran (IOMobileFramebufferLegacy's power state changes). Polling a passive source is
+	 * harmless (IOEventSource::checkForWork does nothing), so all are active unless marked kPassive.
+	 */
+#else
+	else if (controlG) {
 		void *  ptr1;
 		void *  ptr2;
 
@@ -717,6 +726,7 @@ IOWorkLoop::eventSourcePerformsWork(IOEventSource *inEventSource)
 			result = false;
 		}
 	}
+#endif
 
 	return result;
 }
