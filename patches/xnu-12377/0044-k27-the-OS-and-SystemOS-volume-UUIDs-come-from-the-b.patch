From 6b75ce7c4dc3ed8fc249c09eb6b5397ef6021a4e Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Sat, 7 Nov 2026 01:04:03 -0500
Subject: [PATCH 44/44] k27: the OS and SystemOS volume UUIDs come from the
 boot, not the source

The shared-cache carrier check (vm_unix.c) and the owner boot manifest (kern_exec.c) named the
macOS 27.0.1 OS volume (C73696D4-...) and the SystemOS volume (8846FE78-...) as constants, so
another OS image needed a kernel change.

native_owner_root_volume_uuid() reads the mounted root's volume UUID (vfs_getattr f_uuid, as
imageboot's set_fake_bootuuid); native_owner_systemos_volume_uuid() reads
/chosen/owner-systemos-uuid, which scripts/run-macos-vm.py takes from the SystemOS image.
XNU_OWNER_CACHE_CARRIER_WRONG_UUID still tests a UUID that names no volume: the one read, its
first character changed.
---
 bsd/kern/kern_exec.c | 47 ++++++++++++++++++++++++++++++++++++++++----
 bsd/vm/vm_unix.c     | 15 +++++++-------
 2 files changed, 51 insertions(+), 11 deletions(-)

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 7de3e17..49765bc 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8091,10 +8091,47 @@ native_owner_cache_checkpoint(int status, int authorized)
 	__asm__ volatile("" : : "r"(status), "r"(authorized) : "memory");
 }
 
+/* The volume UUID of the mounted OS root, as text: the kernel follows whichever OS image it was booted from. */
+int native_owner_root_volume_uuid(mount_t, uuid_string_t);
+int
+native_owner_root_volume_uuid(mount_t mp, uuid_string_t text)
+{
+	struct vfs_attr va;
+	VFSATTR_INIT(&va);
+	VFSATTR_WANTED(&va, f_uuid);
+	if (!mp || vfs_getattr(mp, &va, vfs_context_current()) || !VFSATTR_IS_SUPPORTED(&va, f_uuid)) {
+		return 0;
+	}
+	uuid_unparse_upper(va.f_uuid, text);
+	return 1;
+}
+
+/* The SystemOS volume UUID the boot loader read from the SystemOS image: /chosen/owner-systemos-uuid (scripts/run-macos-vm.py). */
+int native_owner_systemos_volume_uuid(uuid_string_t);
+int
+native_owner_systemos_volume_uuid(uuid_string_t text)
+{
+	static uuid_string_t cached;
+	DTEntry chosen;
+	void const *value;
+	unsigned int size;
+	uuid_t parsed;
+	if (!cached[0]) {
+		if (SecureDTLookupEntry(0, "/chosen", &chosen) != kSuccess ||
+		    SecureDTGetProperty(chosen, "owner-systemos-uuid", &value, &size) != kSuccess ||
+		    size != sizeof(uuid_string_t) || ((const char *)value)[size - 1] || uuid_parse(value, parsed)) {
+			return 0;
+		}
+		uuid_unparse_upper(parsed, cached);
+	}
+	strlcpy(text, cached, sizeof(uuid_string_t));
+	return 1;
+}
+
 static int
 native_owner_cache_prepare(proc_t p, user_addr_t scratch, user_addr_t *envp)
 {
-	const char *volume = "8846FE78-2910-4297-AF97-D59BB6F8FC16";
+	uuid_string_t volume;
 #if defined(XNU_OWNER_UNION_SYSTEMOS) && XNU_OWNER_UNION_SYSTEMOS
 #if !CONFIG_UNION_MOUNTS
 #error The owner composition requires the original native union-mount implementation
@@ -8140,7 +8177,8 @@ native_owner_cache_prepare(proc_t p, user_addr_t scratch, user_addr_t *envp)
 	    native_verified_block_root_authorized(root_device);
 	if (!root_authorized) goto done;
 	native_owner_cache_stage = 1;
-	if (!native_verified_block_volume_device(volume, &selected, device_path,
+	if (!native_owner_systemos_volume_uuid(volume) ||
+	    !native_verified_block_volume_device(volume, &selected, device_path,
 	    sizeof(device_path))) goto done;
 	strlcpy(native_owner_cache_device_path, device_path, sizeof(native_owner_cache_device_path));
 	native_owner_cache_selected_device = selected;
@@ -8198,9 +8236,10 @@ done:
 	native_owner_cache_root_recheck = root_recheck;
 	if (!root_recheck) error = EAUTH;
 #if defined(XNU_OWNER_BOOT_MANIFEST) && XNU_OWNER_BOOT_MANIFEST
+	uuid_string_t root_uuid;
 	if (!error && cache_authorized && root_recheck &&
-	    !native_owner_publish_boot_manifest(root_device, "C73696D4-CAC4-40A0-90CB-7D0463E4E3E6",
-	        selected, volume)) error = EAUTH;
+	    (!native_owner_root_volume_uuid(root_mount, root_uuid) ||
+	    !native_owner_publish_boot_manifest(root_device, root_uuid, selected, volume))) error = EAUTH;
 #endif
 #if defined(XNU_OWNER_CACHE_STARTUP) && XNU_OWNER_CACHE_STARTUP
 	if (!error && cache_authorized && root_recheck) {
diff --git a/bsd/vm/vm_unix.c b/bsd/vm/vm_unix.c
index 222b708..c24f6d3 100644
--- a/bsd/vm/vm_unix.c
+++ b/bsd/vm/vm_unix.c
@@ -1390,6 +1390,8 @@ static void shared_region_map_and_slide_cleanup(
 #endif
 extern int native_verified_block_root_authorized(dev_t);
 extern int native_verified_block_volume_device(const char *, dev_t *, char *, size_t);
+extern int native_owner_root_volume_uuid(mount_t, uuid_string_t);
+extern int native_owner_systemos_volume_uuid(uuid_string_t);
 unsigned long native_owner_cache_carrier_accepts = 0;
 unsigned long native_owner_cache_carrier_rejects = 0;
 volatile dev_t native_owner_cache_carrier_root_device = NODEV;
@@ -1398,12 +1400,7 @@ volatile dev_t native_owner_cache_carrier_file_device = NODEV;
 static boolean_t
 native_owner_shared_cache_carrier(vnode_t process_root, vnode_t file)
 {
-	const char *root_uuid = "C73696D4-CAC4-40A0-90CB-7D0463E4E3E6";
-#if defined(XNU_OWNER_CACHE_CARRIER_WRONG_UUID) && XNU_OWNER_CACHE_CARRIER_WRONG_UUID
-	const char *cache_uuid = "9846FE78-2910-4297-AF97-D59BB6F8FC16";
-#else
-	const char *cache_uuid = "8846FE78-2910-4297-AF97-D59BB6F8FC16";
-#endif
+	uuid_string_t root_uuid, cache_uuid;
 	const char *directory = "/private/preboot/System/Library/Caches/com.apple.dyld";
 	vnode_t expected_parent = NULLVP, device_vnode;
 	dev_t root_device = NODEV, cache_device = NODEV, expected = NODEV;
@@ -1425,7 +1422,11 @@ native_owner_shared_cache_carrier(vnode_t process_root, vnode_t file)
 		cache_device = vnode_specrdev(device_vnode);
 		vnode_put(device_vnode);
 	}
-	if (root_device == NODEV || cache_device == NODEV ||
+	if (root_device == NODEV || cache_device == NODEV || !native_owner_root_volume_uuid(root_mount, root_uuid) ||
+	    !native_owner_systemos_volume_uuid(cache_uuid) ||
+#if defined(XNU_OWNER_CACHE_CARRIER_WRONG_UUID) && XNU_OWNER_CACHE_CARRIER_WRONG_UUID
+	    !(cache_uuid[0] ^= 1) ||    /* the negative test: a SystemOS UUID that names no volume */
+#endif
 	    !native_verified_block_volume_device(root_uuid, &expected, device_path, sizeof(device_path)) ||
 	    expected != root_device ||
 	    !native_verified_block_volume_device(cache_uuid, &expected, device_path, sizeof(device_path)) ||
