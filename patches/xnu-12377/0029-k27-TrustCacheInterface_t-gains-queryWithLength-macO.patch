From a04413d58cae7c269f656e199952f0ec543d47b2 Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Fri, 30 Oct 2026 03:25:46 -0400
Subject: [PATCH 29/47] k27: TrustCacheInterface_t gains queryWithLength (macOS
 27 AMFI interface version 5)

27's AMFI registers an amfi_t whose TrustCache interface appends trustCacheQueryWithLength; everything after it (OSEntitlements,
MTE) moves by 8 bytes, so amfi->OSEntitlements.queryEntitlementBooleanWithProc landed on matchBool with a proc (PAC panic in
safeMetaCast from IOCurrentTaskHasEntitlement in bsdinit_task).

(cherry picked from commit 3715cb249a9be1fa2fcc13df2ce4fd3f352d62aa)
---
 libkern/libkern/amfi/amfi.h | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/libkern/libkern/amfi/amfi.h b/libkern/libkern/amfi/amfi.h
index 2473393..02e4228 100644
--- a/libkern/libkern/amfi/amfi.h
+++ b/libkern/libkern/amfi/amfi.h
@@ -182,6 +182,14 @@ typedef TCReturn_t (*query_t)(
 	TrustCacheQueryToken_t *queryToken
 	);
 
+typedef TCReturn_t (*queryWithLength_t)(
+	const TrustCacheRuntime_t *runtime,
+	TCQueryType_t queryType,
+	const uint8_t *CDHash,
+	size_t CDHashLength,
+	TrustCacheQueryToken_t *queryToken
+	);
+
 typedef TCReturn_t (*getModule_t)(
 	const TrustCache_t *trustCache,
 	const uint8_t **moduleAddrRet,
@@ -247,6 +255,10 @@ typedef struct _TrustCacheInterface {
 	extractModule_t extractModule;
 	getModule_t getModule;
 	getUUID_t getUUID;
+
+	/* k27: macOS 27's AMFI registers interface version 5, which appends this (variable-length CDHash query); everything after
+	 * TrustCache in amfi_t moves by its size */
+	queryWithLength_t queryWithLength;
 } TrustCacheInterface_t;
 
 #define APPLE_FEATURE_MTE 1
