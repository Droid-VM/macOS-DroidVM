From a273781ce12e7e4278da01afebd754e4d475d226 Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Fri, 30 Oct 2026 04:01:44 -0400
Subject: [PATCH 39/48] k27: firmlink path rewrite also for callers that want
 the mount point length (0, as xnu's firmlink walk)

---
 bsd/vfs/vfs_cache.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/bsd/vfs/vfs_cache.c b/bsd/vfs/vfs_cache.c
index b3e27f2..be2feb0 100644
--- a/bsd/vfs/vfs_cache.c
+++ b/bsd/vfs/vfs_cache.c
@@ -515,8 +515,8 @@ static int build_path_with_parent_raw(vnode_t, vnode_t, char *, int, int *, size
  * k27 (k27-firmlink-paths, default on): the system volume links /Library, /Users, /Applications, /private/etc, ... to
  * /private/var/.data/... (scripts/make-macos-systemos.sh) where macOS has firmlinks into the Data volume. A firmlinked path reads
  * back as /Library/...; macOS 27's Sandbox profiles are written against those paths, so the paths of /private/var/.data/X read back
- * as /X here too (they resolve to the same vnode through the links). Not for BUILDPATH_NO_FIRMLINK or a caller that wants the
- * mount point length.
+ * as /X here too (they resolve to the same vnode through the links). Not for BUILDPATH_NO_FIRMLINK; the mount point
+ * length of such a path is 0.
  */
 static TUNABLE(bool, k27_firmlink_paths, "k27-firmlink-paths", true);
 
@@ -527,10 +527,13 @@ build_path_with_parent(vnode_t first_vp, vnode_t parent_vp, char *buff, int bufl
 	static const char prefix[] = "/private/var/.data";
 	const size_t plen = sizeof(prefix) - 1;
 	int ret = build_path_with_parent_raw(first_vp, parent_vp, buff, buflen, outlen, mntpt_outlen, flags, ctx);
-	if (ret == 0 && k27_firmlink_paths && mntpt_outlen == NULL && !(flags & BUILDPATH_NO_FIRMLINK) &&
+	if (ret == 0 && k27_firmlink_paths && !(flags & BUILDPATH_NO_FIRMLINK) &&
 	    *outlen > (int)plen + 1 && strncmp(buff, prefix, plen) == 0 && buff[plen] == '/') {
 		memmove(buff, buff + plen, (size_t)*outlen - plen);
 		*outlen -= (int)plen;
+		if (mntpt_outlen) {
+			*mntpt_outlen = 0;      /* a firmlinked path crosses no mount point (xnu's firmlink walk leaves it unset) */
+		}
 	}
 	return ret;
 }
