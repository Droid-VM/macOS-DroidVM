From 6191d97946f40ae10a197e363b0d817fda974ce9 Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Fri, 30 Oct 2026 01:55:48 -0400
Subject: [PATCH 29/48] k27: IOService::CallPlatformFunction (27's iig method,
 referenced by AppleARMPlatform)

---
 bsd/kern/k27_compat.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/bsd/kern/k27_compat.c b/bsd/kern/k27_compat.c
index 88428d7..7bc5e33 100644
--- a/bsd/kern/k27_compat.c
+++ b/bsd/kern/k27_compat.c
@@ -187,3 +187,18 @@ image4_v2_load_local_policy(const void *a, const void *b)
 {
 	return (a && b) ? 8 : 3;
 }
+
+/*
+ * IOService::CallPlatformFunction(OSString *, bool, OSDictionary *, OSDictionary **, OSDispatchMethod), the DriverKit method 27 added
+ * to IOService (iig): 27's AppleARMPlatform keeps a pointer to it in its dispatch data. This kernel's IOService.iig has no such
+ * method, so nothing dispatches to it; unsupported if anything does.
+ */
+int k27_IOService_CallPlatformFunction(void *self, void *name, bool wait, void *in, void **out, void *supermethod)
+__asm__("__ZN9IOService20CallPlatformFunctionEP8OSStringbP12OSDictionaryPS3_PFiP15OSMetaClassBase5IORPCE");
+
+int
+k27_IOService_CallPlatformFunction(__unused void *self, __unused void *name, __unused bool wait, __unused void *in,
+    __unused void **out, __unused void *supermethod)
+{
+	return (int)0xe00002c7;   /* kIOReturnUnsupported */
+}
