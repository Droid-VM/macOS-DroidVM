From 8e94e112815834a1c539c5f3c7c4177941f4e031 Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Tue, 27 Oct 2026 07:57:13 -0400
Subject: [PATCH] AMP on the virtual board: two clusters and the sched_amp
 scheduler; each CPU's cluster type comes from the device tree's cluster-type
 ('E' or 'P', from the host's vCPU capacities), not the CPU driver's boot
 cluster type; one type of core only skips the two-pset checks (verified: all
 'P' boots with hw.nperflevels 1, EEEEEEPP with Performance 2 / Efficiency 6)

---
 osfmk/arm64/machine_routines.c       |  4 ++++
 osfmk/kern/sched_amp.c               |  4 ++++
 pexpert/pexpert/arm64/board_config.h | 10 +++++++++-
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index bf85a10..7298681 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1681,6 +1681,10 @@ ml_processor_register(ml_processor_info_t *in_processor_info,
 	this_cpu_datap->cpu_regmap_paddr = in_processor_info->regmap_paddr;
 	this_cpu_datap->cpu_phys_id = in_processor_info->phys_id;
 
+#if defined(ARM64_BOARD_CONFIG_BCM2837) && __AMP__
+	/* The virtual board's CPU driver registers every CPU with the boot CPU's cluster type; the device tree's is the CPU's own. */
+	in_processor_info->cluster_type = topology_info.cpus[in_processor_info->log_id].cluster_type;
+#endif
 	this_cpu_datap->cpu_cluster_type = in_processor_info->cluster_type;
 	this_cpu_datap->cpu_cluster_id = in_processor_info->cluster_id;
 	this_cpu_datap->cpu_l2_id = in_processor_info->l2_cache_id;
diff --git a/osfmk/kern/sched_amp.c b/osfmk/kern/sched_amp.c
index e016231..d5aa40e 100644
--- a/osfmk/kern/sched_amp.c
+++ b/osfmk/kern/sched_amp.c
@@ -712,6 +712,10 @@ sched_amp_cpu_init_completed(void)
 		/* If number of cpus booted is restricted, these asserts may not be true */
 		return;
 	}
+	if (ecore_set == NULL || pcore_set == NULL) {
+		/* One type of core only (a virtual machine whose host gave every vCPU the same capacity) */
+		return;
+	}
 
 	assert(pset_array[0] != NULL);
 	assert(pset_array[1] != NULL);
diff --git a/pexpert/pexpert/arm64/board_config.h b/pexpert/pexpert/arm64/board_config.h
index 786abff..69f6787 100644
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -309,7 +309,15 @@
 
 #define MAX_L2_CLINE                   6
 #define MAX_CPUS                       8 /* SM8550 (sheng) and SM8350 (zeta) have eight cores */
-#define MAX_CPU_CLUSTERS               1
+/*
+ * Two clusters: the device tree's cpus carry cluster-type 'E' or 'P' from the host's cpu capacities (make-droidvm-adt.py; all
+ * 'P' when the host gives every vCPU the same). The AMP scheduler (sched_amp, not Edge: Edge places threads by CLPC's thread group
+ * recommendations, and without CLPC every thread prefers the boot cluster) puts user threads above utility priority on P cores and
+ * background, utility and kernel threads on E cores, spilling to E cores when the P cores are loaded.
+ */
+#define MAX_CPU_CLUSTERS               2
+#define __ARM_AMP__                    1
+#define CONFIG_SCHED_EDGE_OPT_OUT      1
 
 #define NO_XNU_PLATFORM_ERROR_HANDLER  1
 #define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
-- 
2.53.0

