From f68198137061575ea6f7a071e067faadee68c4da Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Sat, 7 Nov 2026 12:42:39 -0500
Subject: [PATCH 46/49] k27: mmu_kvtop_wpreflight synchronizes PAR_EL1 with an
 ISB (a stale fault sent bcopy_phys to a copy window, a DMG read panicked)

---
 osfmk/arm64/machine_routines_asm.s | 1 +
 1 file changed, 1 insertion(+)

diff --git a/osfmk/arm64/machine_routines_asm.s b/osfmk/arm64/machine_routines_asm.s
index 864fb20..96650a0 100644
--- a/osfmk/arm64/machine_routines_asm.s
+++ b/osfmk/arm64/machine_routines_asm.s
@@ -458,6 +458,7 @@ LEXT(mmu_kvtop_wpreflight)
 	mrs		x2, DAIF									// Load current DAIF
 	msr		DAIFSet, #(DAIFSC_STANDARD_DISABLE)		// Disable all asynchronous exceptions
 	at		s1e1w, x0									// Translation Stage 1 EL1
+	isb		sy											// PAR_EL1 needs the ISB (Apple's cores forgive it, others return a stale fault: bcopy_phys then takes a copy window with preemption off)
 	mrs		x1, PAR_EL1									// Read result
 	msr		DAIF, x2									// Restore interrupt state
 	tbnz	x1, #0, L_mmu_kvtop_wpreflight_invalid		// Test Translation not valid
