From 9628bf27833cb3696ddff3000d15cc6a32737c55 Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Fri, 30 Oct 2026 02:35:38 -0400
Subject: [PATCH 28/49] k27 diagnostics: stall-panic=SECONDS panics from the
 timer interrupt while launchd has not started (every core's PC in the panic
 log)

(cherry picked from commit 73c9ce51b81069f5e0972f7af07aebc8ab3b1ce8)
---
 osfmk/arm/rtclock.c    |  3 +++
 osfmk/kern/k27_stall.c | 25 +++++++++++++++++++++++++
 2 files changed, 28 insertions(+)

diff --git a/osfmk/arm/rtclock.c b/osfmk/arm/rtclock.c
index fb707d1..a17a07d 100644
--- a/osfmk/arm/rtclock.c
+++ b/osfmk/arm/rtclock.c
@@ -342,6 +342,9 @@ rtclock_intr(__unused unsigned int is_user_context)
 
 	abstime = mach_absolute_time();
 
+	extern void k27_stall_tick(uint64_t);
+	k27_stall_tick(abstime);       /* k27 diagnostics: stall-panic=SECONDS */
+
 	if (cdp->cpu_idle_pop != 0x0ULL) {
 		if ((cdp->rtcPop - abstime) < cdp->cpu_idle_latency) {
 			cdp->cpu_idle_pop = 0x0ULL;
diff --git a/osfmk/kern/k27_stall.c b/osfmk/kern/k27_stall.c
index 36cdbf2..ca7ff25 100644
--- a/osfmk/kern/k27_stall.c
+++ b/osfmk/kern/k27_stall.c
@@ -17,6 +17,31 @@ extern void *initproc;
 extern lck_mtx_t tasks_threads_lock;
 
 static TUNABLE(uint32_t, k27_stall_seconds, "stall-dump", 0);
+/*
+ * stall-panic=SECONDS: the first timer interrupt after that long without launchd panics, from interrupt context, so that the panic log
+ * has every core's PC (DebuggerXCall) even when no thread can be scheduled any more. Pair it with panic-spin=1, and with stall-dump so
+ * that a timer deadline exists then.
+ */
+static TUNABLE(uint32_t, k27_stall_panic_seconds, "stall-panic", 0);
+
+void k27_stall_tick(uint64_t now);
+
+void
+k27_stall_tick(uint64_t now)
+{
+	static uint64_t deadline;
+	static bool fired;
+	if (k27_stall_panic_seconds == 0 || fired || initproc != NULL) {
+		return;
+	}
+	if (deadline == 0) {
+		nanoseconds_to_absolutetime((uint64_t)k27_stall_panic_seconds * NSEC_PER_SEC, &deadline);
+	}
+	if (now >= deadline) {
+		fired = true;
+		panic("k27 stall: no launchd after %u s", k27_stall_panic_seconds);
+	}
+}
 
 static void k27_stall_check(thread_call_param_t, thread_call_param_t);
 
