 	 */
+	kprintf("port: kext_alloc_init\n");
 	kext_alloc_init();
+	kprintf("port: kext_alloc_init done\n");
 
 	/*
 	 * Eat a random amount of kernel_map to fuzz subsequent heap, zone and
@@ -3159,11 +3161,17 @@ kmem_scramble_ranges(void)
 	 * do not admit this address to be part of any zone submap.
 	 */
 	km_range = kmem_fuzz_start();
+	kprintf("port: fuzz %llx-%llx\n", (unsigned long long)km_range.min_address, (unsigned long long)km_range.max_address);
 
 	/*
 	 * Add claims for ptr and data kmem ranges
