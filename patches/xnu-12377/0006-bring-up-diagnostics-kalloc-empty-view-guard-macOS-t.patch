 	kmem_add_extra_claims(km_range);
+	kprintf("port: claims %u\n", kmem_claim_count);
+	for (uint32_t i = 0; i < kmem_claim_count; i++) {
+		kprintf("port: claim[%u] %s size %llx flags %x\n", i, kmem_claims[i].kc_name, (unsigned long long)kmem_claims[i].kc_size, (unsigned)kmem_claims[i].kc_flags);
+	}
+	kprintf("port: free_size %llx\n", (unsigned long long)mach_vm_range_size(&km_range));
 
 	/*
 	 * Minimally verify that our placer will be able to resolve the constraints
@@ -3193,8 +3201,10 @@ kmem_scramble_ranges(void)
 	 */
 	assert(kmem_claim_count < UINT16_MAX);
 	kmem_shuffle_claims();
+	kprintf("port: shuffled\n");
 
 	vm_map_ilk_lock(kernel_map);
+	kprintf("port: locked\n");
 
 	/*
 	 * Apply restrictions and determine range for each claim
@@ -3214,6 +3224,8 @@ kmem_scramble_ranges(void)
 		    km_range.min_address, vm_map_max(kernel_map));
 		sp_size   = kmem_claim_to_allocation_size(sp.kc_size, is_last);
 
+		kprintf("port: claim %s size %llx alloc %llx hole %llx\n", sp.kc_name, (unsigned long long)sp.kc_size,
+		    (unsigned long long)sp_size, (unsigned long long)hole_size);
 		if (hole_size < sp_size) {
 			panic("kmem_range_init: vm_map_store_lookup_hole() "
 			    "failing for claim %s, hole %#llx < size %#llx",
@@ -3265,6 +3277,7 @@ kmem_scramble_ranges(void)
 	}
 
 	vm_map_ilk_unlock(kernel_map);
+	kprintf("port: unlocked\n");
 
 #if DEBUG || DEVELOPMENT
 	for (uint32_t i = 0; i < kmem_claim_count; i++) {
@@ -3294,8 +3307,11 @@ __startup_func
 static void
 kmem_range_init(void)
 {
+	kprintf("port: kmem_scramble_ranges\n");
 	kmem_scramble_ranges();
+	kprintf("port: pmap_init\n");
 	pmap_init();
+	kprintf("port: pmap_init done\n");
 
 	for (uint32_t i = 0; i < ARRAY_COUNT(kmem_slabs); i++) {
 		vm_guard_object_slab_init(&kmem_slabs[i][KMEM_DIRECTION_FORWARDS]);
