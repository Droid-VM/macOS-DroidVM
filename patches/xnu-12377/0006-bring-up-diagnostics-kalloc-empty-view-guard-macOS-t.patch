diff --git a/osfmk/vm/vm_compressor_backing_store.c b/osfmk/vm/vm_compressor_backing_store.c
index 10a4aee..03e234d 100644
--- a/osfmk/vm/vm_compressor_backing_store.c
+++ b/osfmk/vm/vm_compressor_backing_store.c
@@ -172,7 +172,7 @@ boolean_t vm_swap_force_defrag = FALSE, vm_swap_force_reclaim = FALSE;
 
 #else /* !XNU_TARGET_OS_OSX */
 
-#define VM_MAX_SWAP_FILE_NUM            100
+#define VM_MAX_SWAP_FILE_NUM            5 /* port: 100 swap files reserve ~150 GB of kernel VA for the compressor, more than this 4 KiB-page layout has */
 /* port: the macOS-target code at vm_swap_init() still scales by these; values as the !XNU_TARGET_OS_OSX branch gives a non-large-memory device */
 #define VM_MAX_SWAP_FILE_SWAP_ENABLED_NUM (4ULL * (1ULL << 30) / MAX_SWAP_FILE_SIZE)
 #define VM_MIN_SWAP_FILE_SWAP_ENABLED_NUM (4ULL * (1ULL << 30) / MAX_SWAP_FILE_SIZE)
