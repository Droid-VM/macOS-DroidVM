diff --git a/osfmk/kern/kalloc.c b/osfmk/kern/kalloc.c
index 74b028f..5d37de5 100644
--- a/osfmk/kern/kalloc.c
+++ b/osfmk/kern/kalloc.c
@@ -1861,13 +1861,21 @@ __startup_func
 static void
 kalloc_type_view_init_fixed(void)
 {
+	kprintf("port: ktv fixed start\n");
 	kalloc_type_hash_seed = (uint32_t) early_random();
+	kprintf("port: ktv seed\n");
 	kalloc_type_build_dlut();
+	kprintf("port: ktv dlut\n");
 	/*
 	 * Parse __kalloc_type sections and build array of pointers to
 	 * all kalloc type views in kt_buffer.
 	 */
 	kt_count = kalloc_type_view_parse(KTV_FIXED);
+	kprintf("port: ktv parsed %u\n", (unsigned)kt_count);
+	if (kt_count == 0) {
+		/* port: without Apple's type summary every view counts as data-only and takes the data heap above, so there is nothing to place */
+		return;
+	}
 	assert(kt_count < KALLOC_TYPE_SIZE_MASK);
 
 #if MACH_ASSERT
@@ -1887,9 +1895,11 @@ kalloc_type_view_init_fixed(void)
 	 * frequency list of number of unique and total signatures per kalloc
 	 * size class
 	 */
+	kprintf("port: ktv sorted\n");
 	uint16_t *kt_skip_list_start = (uint16_t *)(kt_buffer + kt_count);
 	uint16_t *kt_shuffle_buf = kalloc_type_create_iterators_fixed(
 		kt_skip_list_start, kt_count);
+	kprintf("port: ktv iterators\n");
 
 	/*
 	 * Create zones based on signatures
@@ -1989,6 +1999,9 @@ kalloc_type_view_init_var(void)
 	 */
 	kt_count = kalloc_type_view_parse(KTV_VAR);
 	assert(kt_count < UINT32_MAX);
+	if (kt_count == 0) {
+		return; /* port: see kalloc_type_view_init_fixed */
+	}
 
 #if MACH_ASSERT
 	vm_size_t sig_slist_size = (size_t) kt_count * sizeof(uint32_t);
diff --git a/osfmk/kern/link_compat.c b/osfmk/kern/link_compat.c
