@@ -1277,10 +1277,10 @@ mac_vnode_check_exec(vfs_context_t ctx, struct vnode *vp,
 				void *spawnattr = exec_spawnattr_getmacpolicyinfo(&imgp->ip_px_smpx, mpc->mpc_name, &spawnattrlen);
 
