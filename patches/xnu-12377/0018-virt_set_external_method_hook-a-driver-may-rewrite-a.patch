From 49c082fd258c661aad4341d4757f4b63f236a91b Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Sat, 24 Oct 2026 22:05:02 -0400
Subject: [PATCH 18/40] virt_set_external_method_hook: a driver may rewrite an
 external method's inband input in place before the user client's dispatch
 checks it (DroidVMDisplay converts macOS 27's 1760-byte IOMobileFramebuffer
 swap record to the 1416 bytes the 26.5 family takes; every swap_end failed
 kIOReturnBadArgument); mach_absolute_time starts at 0 on the BCM2837 board
 (Gunyah passes the host's counter through, so HID idle time read as hours);
 stderr-log logs a whole write line by line; virt_log_user_backtrace(tag)
 prints the current thread's user frames (verified: WindowServer's swaps reach
 DroidVMDisplay)

(cherry picked from commit e63ad36b7a0995e217641f6b419047cda0dbbf02)
---
 bsd/kern/sys_generic.c        | 27 ++++++++++++++----
 iokit/Kernel/IOUserClient.cpp | 16 +++++++++++
 osfmk/arm64/cpu.c             | 11 ++++++++
 osfmk/kern/exception.c        | 53 ++++++++++++++++++++++++++---------
 4 files changed, 88 insertions(+), 19 deletions(-)

diff --git a/bsd/kern/sys_generic.c b/bsd/kern/sys_generic.c
index edd0012..062b34d 100644
--- a/bsd/kern/sys_generic.c
+++ b/bsd/kern/sys_generic.c
@@ -711,15 +711,30 @@ write_nocancel(struct proc *p, struct write_nocancel_args *uap, user_ssize_t *re
 			stderr_log = v ? 1 : 0;
 		}
 		if (stderr_log && (uap->fd == 1 || uap->fd == 2) && uap->nbyte) {
-			char buf[160];
-			size_t n = uap->nbyte < sizeof(buf) - 1 ? (size_t)uap->nbyte : sizeof(buf) - 1;
-			if (copyin(uap->cbuf, buf, n) == 0) {
+			/* line by line, up to 8 KiB of a write (os_log's `log show` writes kilobytes at once), at most 200 bytes a line */
+			char buf[201];
+			size_t total = uap->nbyte < 8192 ? (size_t)uap->nbyte : 8192, done = 0, used = 0;
+			while (done < total) {
+				char chunk[256];
+				size_t n = total - done < sizeof(chunk) ? total - done : sizeof(chunk);
+				if (copyin(uap->cbuf + done, chunk, n) != 0) {
+					break;
+				}
 				for (size_t i = 0; i < n; i++) {
-					if (buf[i] == '\n' || buf[i] == '\r') {
-						buf[i] = ' ';
+					bool end = chunk[i] == '\n' || chunk[i] == '\r';
+					if (!end) {
+						buf[used++] = chunk[i];
+					}
+					if ((end && used) || used == sizeof(buf) - 1) {
+						buf[used] = 0;
+						printf("fd%d: pid %d %s: %s\n", uap->fd, proc_getpid(p), p->p_comm, buf);
+						used = 0;
 					}
 				}
-				buf[n] = 0;
+				done += n;
+			}
+			if (used) {
+				buf[used] = 0;
 				printf("fd%d: pid %d %s: %s\n", uap->fd, proc_getpid(p), p->p_comm, buf);
 			}
 		}
diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
index a63278e..5e2ef5c 100644
--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -5230,6 +5230,18 @@ is_io_connect_method_var_output
 	return ret;
 }
 
+// Bring-up: a driver's look at an external method's arguments before the user client's dispatch checks them. The input structure
+// lies in the MIG request's io_struct_inband_t, so the hook may rewrite it in place and shrink structureInputSize (DroidVMDisplay
+// converts macOS 27's IOMobileFramebuffer swap record to the one the 26.5 family takes).
+typedef void (*virt_external_method_hook_t)(IOUserClient *client, IOExternalMethodArguments *args);
+static virt_external_method_hook_t virt_external_method_hook;
+
+extern "C" void
+virt_set_external_method_hook(virt_external_method_hook_t hook)
+{
+	virt_external_method_hook = hook;
+}
+
 /* Routine io_user_client_method */
 kern_return_t
 is_io_connect_method
@@ -5309,6 +5321,10 @@ is_io_connect_method
 	    ? ((typeof(args.structureOutputDescriptorSize)) * ool_output_size)
 	    : 0;
 
+	if (virt_external_method_hook && !ool_input) {
+		virt_external_method_hook(client, &args);
+	}
+
 	IOStatisticsClientCall();
 	ret = kIOReturnSuccess;
 	io_filter_policy_t filterPolicy = client->filterForTask(current_task(), 0);
diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
index 53f9ce5..ef2cc64 100644
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -999,6 +999,17 @@ cpu_timebase_init(boolean_t from_boot)
 		 */
 		rtclock_base_abstime = wake_abstime - ml_get_hwclock();
 	} else if (from_boot) {
+#if defined(BCM2837)
+		/*
+		 * port: the hypervisor passes the host's counter through (no CNTVOFF), so the timebase stood at the host's uptime
+		 * at boot. Start mach_absolute_time() at 0, as a Mac's does, the way wake does above: HID idle time is now minus
+		 * the last event (none yet: 0), and a timebase hours past 0 put every display to sleep as soon as WindowServer
+		 * came up. The secondary CPUs take this base (cpu_timebase_init(FALSE)).
+		 */
+		if (cdp == &BootCpuData) {
+			rtclock_base_abstime = 0 - ml_get_hwclock();
+		}
+#endif
 #if DEBUG || DEVELOPMENT
 		if (PE_parse_boot_argn("timebase_offset", &timebase_offset, sizeof(timebase_offset))) {
 			rtclock_base_abstime += timebase_offset;
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 2ee0b23..7057d77 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -152,6 +152,20 @@ static TUNABLE(bool, virt_crash_log, "crash-log", false);
 
 #define VIRT_CRASH_FRAMES 48
 
+/* port: where TASK's dyld shared cache is mapped (crash-log and driver backtraces print it to symbolize the frames) */
+static uint64_t
+virt_shared_cache_base(task_t task)
+{
+	vm_shared_region_t shared_region = vm_shared_region_get(task);
+	uint64_t base = 0;
+
+	if (shared_region != NULL) {
+		base = shared_region->sr_base_address + shared_region->sr_first_mapping;
+		vm_shared_region_deallocate(shared_region);
+	}
+	return base;
+}
+
 static void
 virt_crash_log_thread(exception_type_t exception, mach_exception_data_t code, mach_msg_type_number_t codeCnt,
     thread_t thread)
@@ -159,7 +173,6 @@ virt_crash_log_thread(exception_type_t exception, mach_exception_data_t code, ma
 	uintptr_t frames[VIRT_CRASH_FRAMES];
 	struct backtrace_user_info info = BTUINFO_INIT;
 	struct arm_saved_state *state;
-	vm_shared_region_t shared_region;
 	uint64_t cache_base = 0;
 	task_t task = current_task();
 	void *proc = get_bsdtask_info(task);
@@ -181,11 +194,7 @@ virt_crash_log_thread(exception_type_t exception, mach_exception_data_t code, ma
 	default:
 		return;
 	}
-	shared_region = vm_shared_region_get(task);
-	if (shared_region != NULL) {
-		cache_base = shared_region->sr_base_address + shared_region->sr_first_mapping;
-		vm_shared_region_deallocate(shared_region);
-	}
+	cache_base = virt_shared_cache_base(task);
 	state = find_user_regs(thread);
 	printf("crash: pid %d %s exc %d code 0x%llx 0x%llx cache 0x%llx main 0x%llx\n", pid, name, exception,
 	    (unsigned long long)(codeCnt > 0 ? code[0] : 0), (unsigned long long)(codeCnt > 1 ? code[1] : 0),
@@ -237,6 +246,29 @@ virt_crash_log_thread(exception_type_t exception, mach_exception_data_t code, ma
 	}
 }
 
+/* port: the current thread's user frames, after TAG (bring-up diagnostic for drivers: which client call reached them) */
+void
+virt_log_user_backtrace(const char *tag)
+{
+	uintptr_t frames[24];
+	struct backtrace_user_info info = BTUINFO_INIT;
+	task_t task = current_task();
+	void *proc = get_bsdtask_info(task);
+	unsigned int count;
+
+	if (task == kernel_task) {
+		printf("%s: from the kernel\n", tag);
+		return;
+	}
+	count = backtrace_user(frames, 24, NULL, &info);
+	printf("%s: pid %d %s cache 0x%llx main 0x%llx\n", tag, task_pid(task), proc ? proc_name_address(proc) : "?",
+	    (unsigned long long)virt_shared_cache_base(task), (unsigned long long)task->mach_header_vm_address);
+	for (unsigned int i = 0; i < count; i += 4) {
+		printf("%s: #%u 0x%lx 0x%lx 0x%lx 0x%lx\n", tag, i, frames[i], i + 1 < count ? frames[i + 1] : 0,
+		    i + 2 < count ? frames[i + 2] : 0, i + 3 < count ? frames[i + 3] : 0);
+	}
+}
+
 /*
  * Virtual machine boards: boot-arg sample-pid=<pid> [sample-period=<seconds>] prints, every period, one line per thread of that
  * process (state, wait event, user pc/lr/sp/fp) to the message buffer: where a stuck launchd is waiting. sample-name=<name> samples
@@ -1338,8 +1370,7 @@ virt_abort_log_user(int pid, const char *name)
 {
 	uintptr_t frames[VIRT_CRASH_FRAMES];
 	struct backtrace_user_info info = BTUINFO_INIT;
-	vm_shared_region_t shared_region;
-	uint64_t cache_base = 0;
+	uint64_t cache_base;
 	task_t task = current_task();
 	struct arm_saved_state *state;
 	unsigned int count;
@@ -1347,11 +1378,7 @@ virt_abort_log_user(int pid, const char *name)
 	if (!virt_abort_log || task == kernel_task) {
 		return;
 	}
-	shared_region = vm_shared_region_get(task);
-	if (shared_region != NULL) {
-		cache_base = shared_region->sr_base_address + shared_region->sr_first_mapping;
-		vm_shared_region_deallocate(shared_region);
-	}
+	cache_base = virt_shared_cache_base(task);
 	printf("abort: pid %d %s cache 0x%llx main 0x%llx\n", pid, name, (unsigned long long)cache_base,
 	    (unsigned long long)task->mach_header_vm_address);
 	state = find_user_regs(current_thread());
