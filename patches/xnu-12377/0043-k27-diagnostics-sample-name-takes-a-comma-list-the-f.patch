From a87601656d3b2ddf8750193a477d67ea316391fd Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Fri, 30 Oct 2026 08:53:40 -0400
Subject: [PATCH 43/48] k27 diagnostics: sample-name takes a comma list (the
 first process of each name); a resource wait logs the key, IOResources' state
 and whether the resource is published (iokit: wait resource), which told
 IOResources stuck unmatched by a driver started inside its own matching

---
 iokit/Kernel/IOService.cpp | 10 +++++++
 osfmk/kern/exception.c     | 60 ++++++++++++++++++++++++++------------
 2 files changed, 52 insertions(+), 18 deletions(-)

diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 5e28090..9d9d208 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -6785,6 +6785,16 @@ IOService::waitForMatchingServiceWithToken( OSDictionary * matching,
 		if (!notify) {
 			break;
 		}
+#if defined(BCM2837)
+		{
+			/* which half of a resource wait fails: IOResources not (yet) matched, or the resource not published */
+			OSString * key = OSDynamicCast(OSString, matching->getObject(gIOResourceMatchKey));
+			if (key && gIOResources) {
+				IOLog("iokit: wait resource %s state 0x%x/0x%x published %d\n", key->getCStringNoCopy(),
+				    gIOResources->__state[0], gIOResources->__state[1], gIOResources->getProperty(key) != NULL);
+			}
+		}
+#endif
 		if (UINT64_MAX != timeout) {
 			AbsoluteTime deadline;
 			nanoseconds_to_absolutetime(timeout, &deadline);
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 6de7c03..1b6e765 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -286,31 +286,16 @@ extern const char *virt_thread_wmesg(thread_t);
 extern uint64_t virt_region_path(task_t, uint64_t, char *, int, uint64_t *);
 
 static TUNABLE(int, virt_sample_pid, "sample-pid", 0);
-static TUNABLE_STR(virt_sample_name, 32, "sample-name", "");
+static TUNABLE_STR(virt_sample_name, 128, "sample-name", "");
 static int virt_sample_now;   /* the pid sampled this period (the tunables are read-only after startup) */
 extern const char *proc_best_name(struct proc *p);   /* as osfmk/vm/vm_protos.h */
 static TUNABLE(uint32_t, virt_sample_period, "sample-period", 5);
 static thread_call_t virt_sample_call;
 
+/* one process's threads (task_lock'd); proc NULL with sample-pid=-1: the kernel task */
 static void
-virt_sample_run(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+virt_sample_proc(void *proc)
 {
-	void *proc = NULL;
-	virt_sample_now = virt_sample_pid;
-	if (virt_sample_name[0] != '\0') {
-		virt_sample_now = 0;
-		for (int pid = 1; pid < 4000 && proc == NULL; pid++) {
-			proc = proc_find(pid);
-			if (proc != NULL && strncmp(proc_best_name((struct proc *)proc), virt_sample_name, sizeof(virt_sample_name)) != 0) {
-				proc_rele(proc);
-				proc = NULL;
-			} else if (proc != NULL) {
-				virt_sample_now = pid;
-			}
-		}
-	} else if (virt_sample_pid > 0) {
-		proc = proc_find(virt_sample_pid);
-	}
 	if (proc != NULL || (virt_sample_pid < 0 && virt_sample_name[0] == '\0')) {
 		task_t task = proc != NULL ? proc_task(proc) : kernel_task;
 		thread_t thread;
@@ -386,6 +371,45 @@ virt_sample_run(__unused thread_call_param_t p0, __unused thread_call_param_t p1
 			proc_rele(proc);
 		}
 	}
+}
+
+/* sample-name=NAME[,NAME...]: the first process of each name */
+static void
+virt_sample_run(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	void *proc = NULL;
+	virt_sample_now = virt_sample_pid;
+	if (virt_sample_name[0] != '\0') {
+		for (const char *n = virt_sample_name; *n;) {
+			size_t l = 0;
+			while (n[l] && n[l] != ',') {
+				l++;
+			}
+			proc = NULL;
+			virt_sample_now = 0;
+			for (int pid = 1; l && pid < 4000 && proc == NULL; pid++) {
+				proc = proc_find(pid);
+				if (proc != NULL) {
+					const char *name = proc_best_name((struct proc *)proc);
+					if (strlen(name) == l && strncmp(name, n, l) == 0) {
+						virt_sample_now = pid;
+					} else {
+						proc_rele(proc);
+						proc = NULL;
+					}
+				}
+			}
+			if (proc != NULL) {
+				virt_sample_proc(proc);
+			}
+			n += l + (n[l] == ',');
+		}
+	} else {
+		if (virt_sample_pid > 0) {
+			proc = proc_find(virt_sample_pid);
+		}
+		virt_sample_proc(proc);
+	}
 	uint64_t deadline;
 	clock_interval_to_deadline(virt_sample_period, NSEC_PER_SEC, &deadline);
 	thread_call_enter_delayed(virt_sample_call, deadline);
