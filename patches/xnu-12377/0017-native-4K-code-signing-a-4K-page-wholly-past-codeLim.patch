From e087d9d602b83ebc3622d54104d5a37d53c2a4b9 Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Sat, 24 Oct 2026 19:18:25 -0400
Subject: [PATCH 17/47] native 4K code signing: a 4K page wholly past codeLimit
 in the last 16K block is validated NX, as on 16K pages (it was tainted:
 dyld's PrebuiltLoader reads a dylib's code signature through such a page, and
 every loginwindow after the first died with KERN_CODESIGN_ERROR); crash-log
 names the regions of far and x0 and reads 39-bit user addresses

(cherry picked from commit 993ae4de66d4424de5708707f33635508a66307d)
---
 bsd/kern/ubc_subr.c    | 12 ++++++++++++
 osfmk/kern/exception.c |  6 +++++-
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/bsd/kern/ubc_subr.c b/bsd/kern/ubc_subr.c
index ef98eb4..d669dac 100644
--- a/bsd/kern/ubc_subr.c
+++ b/bsd/kern/ubc_subr.c
@@ -6036,6 +6036,18 @@ cs_validate_hash(
 #if defined(XNU_NATIVE_CS_HASH_CACHE) && XNU_NATIVE_CS_HASH_CACHE
 			if (PAGE_SHIFT == 12 && blob->csb_hash_pageshift == 14) {
 				vm_size_t index = (vm_size_t)offset >> PAGE_SHIFT;
+				/*
+				 * A 4K page wholly past codeLimit in the last 16K block: the block's hash stops at
+				 * codeLimit, so on 16K pages these bytes are part of a validated, NX page (the
+				 * partial-page case below). Answer them the same, not tainted: dyld reads the code
+				 * signature (past codeLimit) through such pages.
+				 */
+				if (!(offset & PAGE_MASK) && offset >= codeLimit &&
+				    offset < (off_t)(((uint64_t)codeLimit + 16383) & ~16383ULL)) {
+					*bytes_processed = PAGE_SIZE;
+					*tainted = CS_VALIDATE_NX;
+					return TRUE;
+				}
 				if ((offset & PAGE_MASK) || offset >= codeLimit ||
 				    blob->csb_native4k_hashes == NULL ||
 				    index >= blob->csb_native4k_hash_count ||
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 58056d0..2ee0b23 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -203,7 +203,7 @@ virt_crash_log_thread(exception_type_t exception, mach_exception_data_t code, ma
 		{
 			static const unsigned int dump_regs[] = {19, 0};
 			for (unsigned int d = 0; d < 2; d++) {
-				uint64_t address = get_saved_state_reg(state, dump_regs[d]) & 0xfffffffffULL;
+				uint64_t address = get_saved_state_reg(state, dump_regs[d]) & 0x7fffffffffULL;   /* 39-bit user VA, PAC bits above */
 				uint64_t words[8];
 				if (copyin(address, words, sizeof(words)) == 0) {
 					printf("crash: pid %d mem x%u 0x%llx: %llx %llx %llx %llx %llx %llx %llx %llx\n", pid, dump_regs[d],
@@ -222,6 +222,10 @@ virt_crash_log_thread(exception_type_t exception, mach_exception_data_t code, ma
 		printf("crash: pid %d pc in 0x%llx+0x%llx %s\n", pid, (unsigned long long)start, (unsigned long long)size, path);
 		start = virt_region_path(task, get_saved_state_lr(state), path, sizeof(path), &size);
 		printf("crash: pid %d lr in 0x%llx+0x%llx %s\n", pid, (unsigned long long)start, (unsigned long long)size, path);
+		start = virt_region_path(task, get_saved_state_far(state), path, sizeof(path), &size);
+		printf("crash: pid %d far in 0x%llx+0x%llx %s\n", pid, (unsigned long long)start, (unsigned long long)size, path);
+		start = virt_region_path(task, get_saved_state_reg(state, 0) & 0x7fffffffffULL, path, sizeof(path), &size);
+		printf("crash: pid %d x0 in 0x%llx+0x%llx %s\n", pid, (unsigned long long)start, (unsigned long long)size, path);
 	}
 	count = backtrace_user(frames, VIRT_CRASH_FRAMES, NULL, &info);
 	for (unsigned int i = 0; i < count; i += 4) {
