From: lateautumn233 <lateautumn233@foxmail.com>
Date: Sat, 24 Oct 2026 00:52:10 -0400
Subject: [PATCH 1/9] macOS target build: ext_resolver config, KC segment
 addresses, arm64e PAC defines, kext kalloc type views, 4 KiB contiguous-hint
 and CTRR fallbacks, DriverKit sed

---
 bsd/kern/ubc_subr.c             |  3 ++-
 config/MASTER.arm64.bcm2837     |  4 ++--
 iokit/DriverKit/Makefile        |  3 +++
 libkern/os/base.h               |  5 +++++
 makedefs/MakeInc.def            |  4 ++--
 osfmk/arm64/arm_vm_init.c       | 10 ++++++++++
 osfmk/arm64/machine_routines.c  |  7 +++++++
 osfmk/kern/kalloc.c             | 13 +++++++++++++
 pexpert/pexpert/arm64/BCM2837.h |  5 +++++
 9 files changed, 49 insertions(+), 5 deletions(-)

diff --git a/bsd/kern/ubc_subr.c b/bsd/kern/ubc_subr.c
index 96150a8..ef98eb4 100644
--- a/bsd/kern/ubc_subr.c
+++ b/bsd/kern/ubc_subr.c
@@ -105,6 +105,7 @@ static void ubc_cs_free(struct ubc_info *uip);
 static boolean_t ubc_cs_supports_multilevel_hash(struct cs_blob *blob);
 static kern_return_t ubc_cs_convert_to_multilevel_hash(struct cs_blob *blob);
 #if defined(XNU_NATIVE_CS_HASH_CACHE) && XNU_NATIVE_CS_HASH_CACHE
+#include <mach/mach_vm.h>   /* mach_vm_protect */
 static int cs_native4k_prepare(vnode_t vp, struct cs_blob *blob);
 #endif
 
@@ -5953,7 +5954,7 @@ cs_native4k_prepare(vnode_t vp, struct cs_blob *blob)
 			memcpy((void *)(storage + index * md->cs_size), digest, md->cs_size);
 		}
 	}
-	kr = vm_map_protect(kernel_map, storage, storage + allocation, VM_PROT_READ, TRUE);
+	kr = mach_vm_protect(kernel_map, storage, allocation, TRUE, VM_PROT_READ);
 	if (kr != KERN_SUCCESS) {
 		error = EPERM;
 		goto out;
diff --git a/config/MASTER.arm64.bcm2837 b/config/MASTER.arm64.bcm2837
