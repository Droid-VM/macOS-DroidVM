 #define NO_ECORE 1
 
 #define BCM2837
+/* arm64e kernel (XNU_ARCH=arm64e): the 26.5 kexts are arm64e, so the kernel signs and authenticates pointers too */
+#define CPU_HAS_APPLE_PAC 1
+#if defined(__arm64e__)
+#define HAS_APPLE_PAC 1
+#endif
 #define BCM2837_BRINGUP
 #define ARM_ARCH_TIMER
 
