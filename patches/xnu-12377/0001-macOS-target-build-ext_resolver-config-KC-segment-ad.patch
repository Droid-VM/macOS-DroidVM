diff --git a/iokit/DriverKit/Makefile b/iokit/DriverKit/Makefile
index d456318..8e1ccc4 100644
--- a/iokit/DriverKit/Makefile
+++ b/iokit/DriverKit/Makefile
@@ -60,6 +60,9 @@ $(GENERATED_HEADERS) : \
 	%.h : %.iig
 	@$(LOG_IIG) "$@"
 	$(_v)$(IIG) --def $< --header $@ --impl $(patsubst %.h,%.iig.cpp,$@) --framework-name DriverKit ${OTHER_IIG_FLAGS} -- ${OTHER_IIG_CFLAGS} $(_vstdout)
+	@# port: without Apple clang's __builtin_load_member_function_pointer iig falls back to a union pun, which keeps the member function pointer's
+	@# pointer-auth discriminator and then fails the call through the C function pointer type; OSMemberFunctionCast resigns it correctly
+	$(_v)sed -i 's|^#define SimpleMemberFunctionCast(cfnty, self, func) ({ union.*$$|#define SimpleMemberFunctionCast(cfnty, self, func) OSMemberFunctionCast(cfnty, \&(self), func)|' $(patsubst %.h,%.iig.cpp,$@)
 
 $(GENERATED_IMPL) : $(GENERATED_HEADERS)
 
diff --git a/libkern/os/base.h b/libkern/os/base.h
index 243507d..0e60280 100644
--- a/libkern/os/base.h
+++ b/libkern/os/base.h
@@ -355,7 +355,12 @@ typedef void (^os_block_t)(void);
 #if __has_feature(ptrauth_calls)
 #include <ptrauth.h>
 #define OS_PTRAUTH_SIGNED_PTR(type) __ptrauth(ptrauth_key_process_independent_data, 1, ptrauth_string_discriminator(type))
+#if defined(__apple_build_version__)
 #define OS_PTRAUTH_SIGNED_PTR_AUTH_NULL(type) __ptrauth(ptrauth_key_process_independent_data, 1, ptrauth_string_discriminator(type), "authenticates-null-values")
+#else
+/* upstream LLVM 21 has no "authenticates-null-values" option; null stays unsigned (only xnu-private fields use this) */
+#define OS_PTRAUTH_SIGNED_PTR_AUTH_NULL(type) __ptrauth(ptrauth_key_process_independent_data, 1, ptrauth_string_discriminator(type))
+#endif
 #define OS_PTRAUTH_DISCRIMINATOR(str) ptrauth_string_discriminator(str)
 #define __ptrauth_only
 #else //  __has_feature(ptrauth_calls)
diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 200e3c2..c3969ff 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -1036,8 +1036,8 @@ LDFLAGS_KERNEL_PROFILEX86_64H = $(LDFLAGS_KERNEL_RELEASEX86_64H)
 LDFLAGS_KERNEL_GENARM64 = \
 	-Wl,-pie \
 	-Wl,-static \
-	-Wl,-segaddr,__PRELINK_TEXT,$(ARM64_PLKSEG_ADDR) \
-	-Wl,-image_base,$(ARM64_LINK_ADDR) \
+	$(if $(XNU_KC_SEGADDRS),,-Wl,-segaddr,__PRELINK_TEXT,$(ARM64_PLKSEG_ADDR)) \
+	$(if $(XNU_KC_SEGADDRS),$(XNU_KC_SEGADDRS),-Wl,-image_base,$(ARM64_LINK_ADDR)) \
 	\
 	-Wl,-rename_section,__HIB,__text,__TEXT_EXEC,__hib_text \
 	\
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index e41237f..d856a65 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1682,6 +1682,16 @@ arm_vm_prot_finalize(boot_args * args __unused)
 	}
 
 	/* tighten permissions on kext read only data and code */
+#ifdef BCM2837
+	/*
+	 * port: with 4 KiB pages the kernel's own __TEXT, which sits inside the collection's __PRELINK_TEXT, is large enough to have been
+	 * mapped with the contiguous hint; re-protecting it here without the hint trips the active-mapping assert. It is already RNX.
+	 */
+	if (kernel_mach_header_is_in_fileset(&_mh_execute_header) && segTEXTB >= segPRELINKTEXTB && segTEXTB + segSizeTEXT <= segPRELINKTEXTB + segSizePRELINKTEXT) {
+		arm_vm_page_granular_RNX(segPRELINKTEXTB, segTEXTB - segPRELINKTEXTB, ARM64_GRANULE_ALLOW_BLOCK);
+		arm_vm_page_granular_RNX(segTEXTB + segSizeTEXT, segPRELINKTEXTB + segSizePRELINKTEXT - (segTEXTB + segSizeTEXT), ARM64_GRANULE_ALLOW_BLOCK);
+	} else
+#endif
 	arm_vm_page_granular_RNX(segPRELINKTEXTB, segSizePRELINKTEXT, ARM64_GRANULE_ALLOW_BLOCK);
 	arm_vm_page_granular_RNX(segPLKDATACONSTB, segSizePLKDATACONST, ARM64_GRANULE_ALLOW_BLOCK);
 
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index ac03c45..20d564f 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -3400,6 +3400,13 @@ ml_unsafe_kernel_text_init(void)
 		_unsafe_kernel_text_initialized = true;
 		_unsafe_kernel_text = (0 == *(const int *)value);
 	}
+#ifdef BCM2837
+	else {
+		/* port: the device tree carries no iBoot CTRR property; kernel text is never writable here */
+		_unsafe_kernel_text_initialized = true;
+		_unsafe_kernel_text = false;
+	}
+#endif
 }
 STARTUP(TUNABLES, STARTUP_RANK_FIRST, ml_unsafe_kernel_text_init);
 
diff --git a/osfmk/kern/kalloc.c b/osfmk/kern/kalloc.c
index 5d37de5..94e3292 100644
--- a/osfmk/kern/kalloc.c
+++ b/osfmk/kern/kalloc.c
@@ -1009,7 +1009,20 @@ kalloc_type_view_copy(
 		 * Note that KT_VAR_DATA_HEAP is fake "data" heap, variable kalloc_type handles
 		 * the actual redirection in the entry points kalloc/kfree_type_var_impl.
 		 */
+#ifdef BCM2837
+		/* port: the views of kexts carry Apple's real type signatures, but the kernel's are all data (no type summary); one heap policy for both */
+		if (!kalloc_type_is_data(kt_flags)) {
+			/* the entry points read the flag from the view itself */
+			if (type == KTV_FIXED) {
+				((kalloc_type_view_t)cur)->kt_flags |= KT_DATA_ONLY;
+			} else {
+				((kalloc_type_var_view_t)cur)->kt_flags |= KT_DATA_ONLY;
+			}
+		}
+		if (true) {
+#else
 		if (kalloc_type_is_data(kt_flags)) {
+#endif
 			kalloc_type_func(type, handle_data_view, cur);
 			cur += kalloc_type_func(type, view_sz);
 			continue;
diff --git a/pexpert/pexpert/arm64/BCM2837.h b/pexpert/pexpert/arm64/BCM2837.h
index 72d6568..0d7e976 100644
--- a/pexpert/pexpert/arm64/BCM2837.h
+++ b/pexpert/pexpert/arm64/BCM2837.h
