diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index af28273..28d6eaa 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -6922,9 +6922,10 @@ exec_extract_strings(struct image_params *imgp)
 	}
 
 	/*
-	 * UniXNU virt boards: exec-env=NAME:VAR=VALUE[,VAR=VALUE...] appends each VAR=VALUE to the
+	 * UniXNU virt boards: exec-env=NAME:VAR=VALUE[,VAR=VALUE...][;NAME:...] appends each VAR=VALUE to the
 	 * environment of every executable whose file name is NAME (an A/B test's variable for one
-	 * system daemon, whose launchd job lives on the read-only system volume).
+	 * system daemon, whose launchd job lives on the read-only system volume; WebKit's WebContent
+	 * needs GIGACAGE_ENABLED=no, its 64 GiB cage does not fit the 39-bit user space).
 	 */
 	{
 		static char exec_env[256];
@@ -6932,15 +6933,26 @@ exec_extract_strings(struct image_params *imgp)
 		if (exec_env_state == 0) {
 			exec_env_state = PE_parse_boot_arg_str("exec-env", exec_env, sizeof(exec_env)) ? 2 : 1;
 		}
-		const char *colon = exec_env_state == 2 ? strchr(exec_env, ':') : NULL;
 		const char *path = imgp->ip_strings + strlen(EXECUTABLE_KEY);
 		const char *base = strrchr(path, '/');
 		base = base ? base + 1 : path;
-		if (colon && strlen(base) == (size_t)(colon - exec_env) &&
-		    strncmp(base, exec_env, colon - exec_env) == 0) {
-			for (const char *item = colon + 1; *item != '\0';) {
+		for (const char *group = exec_env_state == 2 ? exec_env : ""; *group != '\0';) {
+			const char *group_end = strchr(group, ';');
+			if (group_end == NULL) {
+				group_end = group + strlen(group);
+			}
+			const char *colon = strchr(group, ':');
+			if (colon == NULL || colon > group_end || strlen(base) != (size_t)(colon - group) ||
+			    strncmp(base, group, colon - group) != 0) {
+				group = group_end + (*group_end == ';');
+				continue;
+			}
+			for (const char *item = colon + 1; item < group_end;) {
 				const char *end = strchr(item, ',');
-				size_t len = end ? (size_t)(end - item) : strlen(item);
+				if (end == NULL || end > group_end) {
+					end = group_end;
+				}
+				size_t len = (size_t)(end - item);
 				char assignment[128];
 				if (len > 0 && len < sizeof(assignment)) {
 					memcpy(assignment, item, len);
@@ -6956,8 +6968,9 @@ exec_extract_strings(struct image_params *imgp)
 					imgp->ip_argspace -= new_ptr_size;
 					imgp->ip_envc++;
 				}
-				item += len + (end ? 1 : 0);
+				item = end + 1;
 			}
+			group = group_end + (*group_end == ';');
 		}
 	}
 
diff --git a/bsd/vfs/vfs_lookup.c b/bsd/vfs/vfs_lookup.c
index fc7e7e5..a83e6b9 100644
--- a/bsd/vfs/vfs_lookup.c
+++ b/bsd/vfs/vfs_lookup.c
@@ -1899,7 +1899,25 @@ lookup_traverse_union(vnode_t dvp, vnode_t *new_dvp, vfs_context_t ctx)
 	NDINIT(&nd, LOOKUP, OP_LOOKUP, USEDVP, UIO_SYSSPACE, CAST_USER_ADDR_T(pp), ctx);
 	nd.ni_dvp = dvp->v_mount->mnt_vnodecovered;
 	error = namei(&nd);
-	if (error == 0) {
+	if (error == 0 && nd.ni_vp->v_mount == dvp->v_mount) {
+		/*
+		 * The path in the covered mount led back into this one (the owner chain's SystemOS volume over the OS volume at "/":
+		 * the OS volume's /System/Cryptexes/App links to /System/Volumes/Preboot/Cryptexes/App, which only the SystemOS volume
+		 * has), so there is no underlying directory: a readdir that went on with this vnode would read the same directory again
+		 * from offset 0 forever (Safari's CFBundle scan of its own bundle never returned), as a lookup would retry it.
+		 */
+		vnode_put(nd.ni_vp);
+		error = ENOENT;
+	} else if (error == 0 && nd.ni_vp->v_type != VDIR) {
+		/*
+		 * The covered mount has no directory there, only a symbolic link: the OS volume's
+		 * /System/Library/PrivateFrameworks/Safari.framework links to /System/Cryptexes/OS/..., a directory of the SystemOS
+		 * volume. getdirentries64 then failed with EINVAL after the upper entries, so CFBundle could not create the bundle
+		 * (bundleWithIdentifier: nil, Safari crashed at launch) and lookups below it failed with ENOTDIR.
+		 */
+		vnode_put(nd.ni_vp);
+		error = ENOENT;
+	} else if (error == 0) {
 		*new_dvp = nd.ni_vp;
 	}
 	nameidone(&nd);
diff --git a/security/mac_base.c b/security/mac_base.c
index 369a7e9..07241a9 100644
--- a/security/mac_base.c
+++ b/security/mac_base.c
@@ -96,6 +96,9 @@
 #include <kern/kalloc.h>
 #include <kern/sched_prim.h>
 #include <kern/task.h>
+#include <mach/mach_vm.h>
+#include <vm/vm_kern_xnu.h>
+#include <vm/vm_map_xnu.h>
 
 #if CONFIG_MACF
 #include <security/mac.h>
@@ -1563,6 +1566,51 @@ mac_proc_check_mac_syscall(proc_t p, const char *target, int callnum)
 /* bring-up: the macOS 27 userland numbers the Sandbox calls differently from the 26.5 kext (boot-arg sandbox-call-shift) */
 extern int virt_sandbox_call_shift, virt_sandbox_call_first;
 
+/*
+ * Bring-up (mac-sandbox-permissive=1): macOS 27 compiles profiles for 204 operations, the 26.5 kext takes 198 ("operation count
+ * mismatch (204 vs 198)") and fails call 0 (set profile) EINVAL; the process then ran unsandboxed, and an app-sandboxed XPC service
+ * (every app extension) traps in libxpc's _xpc_objc_main ("XPC service requested sandbox, but is not sandboxed!"). The filter numbering
+ * changed too (the kext's filter switch grew from 105 to 112 cases), so the profile is not translated: the call goes on with a 26.5
+ * profile allowing every operation (one terminal node, flags 0) and the caller's container. Returns the user address of the
+ * replacement arguments (a page of the caller's map, freed after the call) or 0 to forward the call as it is.
+ */
+#define VIRT_SANDBOX_OPS_KEXT 198
+#define VIRT_SANDBOX_OPS_USER 204
+
+static mach_vm_address_t
+virt_sandbox_allow_all_profile(proc_t p, user_addr_t arg)
+{
+	/* syscall_set_userland_profile's arguments: profile, its size, container, its length */
+	uint64_t args[4];
+	uint8_t header[16];
+	if (!proc_is64bit(p) || copyin(arg, args, sizeof(args)) || args[1] < sizeof(header) ||
+	    copyin((user_addr_t)args[0], header, sizeof(header)) || header[4] != VIRT_SANDBOX_OPS_USER) {
+		return 0;
+	}
+	/* a 16-byte header with no tables, the operation table (2-byte entries in 8-byte units from the node base), the node */
+	const size_t ops_end = sizeof(header) + 2 * VIRT_SANDBOX_OPS_KEXT;
+	const size_t node = (ops_end + 7) & ~(size_t)7;
+	uint8_t profile[node + 8];
+	bzero(profile, sizeof(profile));
+	profile[2] = 1;                         /* node area: one 8-byte node */
+	profile[4] = VIRT_SANDBOX_OPS_KEXT;
+	profile[node] = 1;                      /* terminal, no deny flags (0x1401), no modifiers */
+
+	mach_vm_address_t page = 0;
+	if (mach_vm_allocate_kernel(current_map(), &page, PAGE_SIZE, VM_MAP_KERNEL_FLAGS_ANYWHERE()) != KERN_SUCCESS) {
+		return 0;
+	}
+	uint64_t replaced[4] = { page + sizeof(replaced), sizeof(profile), args[2], args[3] };
+	if (copyout(replaced, (user_addr_t)page, sizeof(replaced)) ||
+	    copyout(profile, (user_addr_t)(page + sizeof(replaced)), sizeof(profile))) {
+		mach_vm_deallocate(current_map(), page, PAGE_SIZE);
+		return 0;
+	}
+	printf("sandbox-call: pid %d %s call 0: a %u-operation profile, applied as allow-all\n", proc_pid(p), proc_best_name(p),
+	    header[4]);
+	return page;
+}
+
 int
 __mac_syscall(proc_t p, struct __mac_syscall_args *uap, int *retv __unused)
 {
@@ -1597,6 +1645,15 @@ __mac_syscall(proc_t p, struct __mac_syscall_args *uap, int *retv __unused)
 		return 0;
 	}
 
+	user_addr_t virt_arg = uap->arg;
+	mach_vm_address_t virt_allow_all = 0;
+	if (virt_mac_sandbox_permissive && uap->call == 0 && strcmp(target, "Sandbox") == 0) {
+		virt_allow_all = virt_sandbox_allow_all_profile(p, uap->arg);
+		if (virt_allow_all) {
+			virt_arg = (user_addr_t)virt_allow_all;
+		}
+	}
+
 	error = ENOPOLICY;
 
 	for (i = 0; i < mac_policy_list.staticmax; i++) {
@@ -1608,7 +1665,7 @@ __mac_syscall(proc_t p, struct __mac_syscall_args *uap, int *retv __unused)
 		if (strcmp(mpc->mpc_name, target) == 0 &&
 		    mpc->mpc_ops->mpo_policy_syscall != NULL) {
 			error = mpc->mpc_ops->mpo_policy_syscall(p,
-			    virt_call, uap->arg);
+			    virt_call, virt_arg);
 			goto done;
 		}
 	}
@@ -1622,7 +1679,7 @@ __mac_syscall(proc_t p, struct __mac_syscall_args *uap, int *retv __unused)
 			if (strcmp(mpc->mpc_name, target) == 0 &&
 			    mpc->mpc_ops->mpo_policy_syscall != NULL) {
 				error = mpc->mpc_ops->mpo_policy_syscall(p,
-				    virt_call, uap->arg);
+				    virt_call, virt_arg);
 				break;
 			}
 		}
@@ -1630,6 +1687,9 @@ __mac_syscall(proc_t p, struct __mac_syscall_args *uap, int *retv __unused)
 	}
 
 done:
+	if (virt_allow_all) {
+		mach_vm_deallocate(current_map(), virt_allow_all, PAGE_SIZE);
+	}
 	/*
 	 * Bring-up (mac-sandbox-permissive=1): a macOS daemon names its own profile in sandbox_init(); the iPadOS Sandbox kext does not
 	 * know it: call 22 (profile lookup) answers ENOENT and the follow-up call 1 (apply) EINVAL, after which the daemon aborts. Report
