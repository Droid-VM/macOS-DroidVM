From da57d880627b05bf0c8bd3a3e1db7364b09d0b2f Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Sat, 24 Oct 2026 00:52:10 -0400
Subject: [PATCH 08/47] owner chain: scratch page before the mounts, a volume's
 device by its IOMedia UUID, rootauth=0 boot-arg

(cherry picked from commit 7c7f30d256944c87cb0347763c306e4bfe68b91a)
---
 bsd/kern/bsd_init.c           |  9 +++++++++
 bsd/kern/kern_exec.c          |  5 +++--
 iokit/bsddev/IOKitBSDInit.cpp |  1 +
 osfmk/kern/link_compat.c      | 30 ++++++++++++++++++++++++++++++
 4 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 5bc65a1..265ef59 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1074,6 +1074,15 @@ bsd_init(void)
 		require_rootauth = TRUE;
 #endif // XNU_TARGET_OS_OSX && defined(__arm64__)
 
+#ifdef BCM2837
+		{
+			/* port: no boot manifest here to authenticate the sealed system volume against; rootauth=0 mounts it unauthenticated (see docs, owner policy) */
+			int rootauth = 1;
+			if (PE_parse_boot_argn("rootauth", &rootauth, sizeof(rootauth)) && rootauth == 0) {
+				require_rootauth = FALSE;
+			}
+		}
+#endif
 		if (require_rootauth) {
 			/* enforce sealedness */
 			int autherr = VNOP_IOCTL(rootvnode, FSIOC_KERNEL_ROOTAUTH, NULL, 0, vfs_context_kernel());
diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 992b9b1..b69e99d 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8193,6 +8193,9 @@ load_init_program(proc_t p)
 	mach_vm_offset_t scratch_addr = 0;
 	mach_vm_size_t map_page_size = vm_map_page_size(map);
 
+	(void) mach_vm_allocate_kernel(map, &scratch_addr, map_page_size,
+	    VM_MAP_KERNEL_FLAGS_ANYWHERE());
+
 #if DEVELOPMENT || DEBUG
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
@@ -8212,8 +8215,6 @@ load_init_program(proc_t p)
 	exec_log_handle = os_log_create("com.apple.xnu.bsd", "exec");
 #endif /* DEVELOPMENT || DEBUG */
 
-	(void) mach_vm_allocate_kernel(map, &scratch_addr, map_page_size,
-	    VM_MAP_KERNEL_FLAGS_ANYWHERE());
 #if CONFIG_MEMORYSTATUS
 	(void) memorystatus_init_at_boot_snapshot();
 #endif /* CONFIG_MEMORYSTATUS */
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 9fa400e..5257b2f 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -1939,3 +1939,4 @@ IOVnodeGetEntitlement(vnode_t vnode, int64_t off, const char *entitlement)
 	}
 	return value;
 }
+
diff --git a/osfmk/kern/link_compat.c b/osfmk/kern/link_compat.c
index ecc09d8..e494eab 100644
--- a/osfmk/kern/link_compat.c
+++ b/osfmk/kern/link_compat.c
@@ -35,3 +35,33 @@ pid_hibernate(void *p, void *args, int *ret)
 
 /* Bring-up breadcrumb: the last boot step reached, read from the host with rig-dmesg.py --peek port_crumb. */
 volatile unsigned long long port_crumb;
+
+/* Fault record of the exception that could not be spilled: ESR, ELR, FAR, SP, flag (locore.s). */
+volatile unsigned long long port_exc[8];
+
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+/*
+ * port: the owner chain of kern_exec.c asks the verified block driver whether a device is the
+ * authenticated one. There is no verified build of the block driver here yet (docs: boot chain, owner policy), so every device is.
+ */
+int
+native_verified_block_root_authorized(unsigned int device)
+{
+	(void)device;
+	return 1;
+}
+
+#include <libkern/crypto/sha2.h>
+/* the manifest digest of a volume: SHA-384 of its UUID text, standing in for the manifest of the verified block driver */
+int
+native_verified_block_manifest_sha384(unsigned int device, const char *uuid, uint8_t digest[48])
+{
+	SHA384_CTX context;
+	(void)device;
+	SHA384_Init(&context);
+	SHA384_Update(&context, uuid, strlen(uuid));
+	SHA384_Final(digest, &context);
+	return 1;
+}
+
+#endif
