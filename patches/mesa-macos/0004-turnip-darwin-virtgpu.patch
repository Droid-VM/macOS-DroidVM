diff --git a/src/freedreno/vulkan/tu_knl_darwin_virtgpu.cc b/src/freedreno/vulkan/tu_knl_darwin_virtgpu.cc
new file mode 100644
index 0000000..ebef055
--- /dev/null
+++ b/src/freedreno/vulkan/tu_knl_darwin_virtgpu.cc
@@ -0,0 +1,648 @@
+/*
+ * Turnip's Darwin kernel backend over the guest's virtio GPU: the NativeAdreno ABI methods tu_knl_darwin.cc calls, served by a DRM
+ * native context (the virtgpu methods of NativeAdreno's user client, DroidVMVirtgpuABI.h) in the msm protocol the host's drm2kgsl
+ * speaks to KGSL. The rest of the backend (addresses, retirement, syncs) is unchanged: it still picks every GPU address, and a BO
+ * still becomes real when it is mapped at one (GEM_NEW and a guest-alloc blob of wired guest pages, which the host imports
+ * IO-coherent). Submissions are GEM_SUBMIT ccmds on one submit queue; their fences are that queue's ring's virtio fences.
+ * TU_DARWIN_VIRTGPU=1 selects it.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <IOKit/IOKitLib.h>
+#include <mach/mach.h>
+#include <os/log.h>
+
+#include "NativeAdrenoABI.h"
+#include "DroidVMVirtgpuABI.h"
+#include "tu_knl_darwin_virtgpu.h"
+
+#include "util/os_time.h"
+
+#define DWV_TUNNEL_MAGIC 0x4e544e4cu
+
+enum {
+   DWV_CAPSET_DRM = 6,
+   DWV_SHMEM_BYTES = 16384,
+   DWV_CCMD_IOCTL_SIMPLE = 2,
+   DWV_CCMD_GEM_NEW = 3,
+   DWV_CCMD_GEM_SUBMIT = 7,
+   DWV_MSM_GET_PARAM = 0xc0186440,       /* DRM_IOCTL_MSM_GET_PARAM */
+   DWV_MSM_SUBMITQUEUE_NEW = 0xc00c644a, /* DRM_IOCTL_MSM_SUBMITQUEUE_NEW */
+   DWV_MSM_PIPE_3D0 = 0x10,
+   DWV_MSM_PARAM_VA_START = 0x0e,
+   DWV_MSM_PARAM_VA_SIZE = 0x0f,
+   DWV_MSM_BO_CACHED_COHERENT = 0x00080000,
+   DWV_MSM_BO_GUEST_ALLOC = 0x80000000u,
+   DWV_MSM_SUBMIT_CMD_BUF = 1,
+   DWV_MSM_SUBMIT_BO_READ = 1,
+   DWV_MSM_SUBMIT_BO_WRITE = 2,
+   DWV_MAX_BOS = 1u << 20,
+};
+
+/* virgl_renderer_capset_drm, its msm part. */
+struct dwv_capset {
+   uint32_t wire_format, major, minor, patch, context_type, pad, has_cached_coherent, priorities;
+   uint64_t va_start, va_size;
+   uint32_t gpu_id, gmem_size;
+   uint64_t gmem_base, chip_id;
+   uint32_t max_freq, highest_bank_bit;
+   uint64_t ubwc_swizzle, macrotile_mode;
+   uint32_t has_raytracing, has_preemption;
+   uint64_t uche_trap_base;
+   uint8_t reserved[160 - 112];   /* the capset is 160 bytes on this host; GET_CAPS zero-pads what is shorter */
+};
+
+/* One NativeAdreno handle: its size from BoAlloc (or BoImport, with the caller's address), then the virtgpu resource BoMap made at
+ * its GPU address. */
+struct dwv_bo {
+   bool used;
+   uint64_t size, iova;
+   uint64_t user_address;   /* BoImport: the caller's pages the blob is made of */
+   uint32_t kernel_handle, resource_id;
+   uint32_t metadata_bytes;
+   char metadata[NativeAdrenoAbiMetadataBytes];
+};
+
+static struct {
+   io_connect_t conn;
+   uint32_t selector;
+   pthread_mutex_t lock;     /* the ccmd sequence (one response area) and the handle table */
+   volatile uint8_t *shmem;
+   uint32_t shmem_handle, seqno;
+   uint32_t queue_id, ring, submit_fence;
+   uint64_t next_blob_id;
+   struct dwv_bo *bos;
+   uint32_t bo_capacity;
+   struct dwv_capset caps;
+   uint64_t va_start, va_size;
+} dwv = {.lock = PTHREAD_MUTEX_INITIALIZER};
+
+static kern_return_t vg_call(uint32_t op, const void *in, size_t in_size, void *out, size_t out_size);
+
+/* The accelerator's class: TU_DARWIN_SERVICE, as the KGSL proxy's open (macOS: AGXAccelerator, which the Metal plugin sets), else the
+ * iOS IOAcceleratorES. */
+static const char *
+dwv_service_name(void)
+{
+   const char *name = getenv("TU_DARWIN_SERVICE");
+   return name && *name && strcmp(name, "NativeAdrenoGpuPublished") ? name : "IOAcceleratorES";
+}
+
+/* Whether the board makes the virtio-gpu context the default 3D path (its kernel answers DROIDVM_VIRTGPU_PARAM_DEFAULT_3D, from
+ * the boot-arg vgpu-3d=1): asked once, over a connection of its own that is closed again. */
+static bool
+dwv_board_default(void)
+{
+   static int answer = -1;
+   if (answer >= 0)
+      return answer;
+   answer = 0;
+   io_service_t service = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching(dwv_service_name()));
+   if (!service)
+      return false;
+   kern_return_t kr = IOServiceOpen(service, mach_task_self(), DROIDVM_VIRTGPU_OPEN_TYPE, &dwv.conn);
+   IOObjectRelease(service);
+   if (kr != KERN_SUCCESS)
+      return false;
+   const uint32_t probe[2] = {DWV_TUNNEL_MAGIC, 0xffffffffu};
+   for (dwv.selector = 0; dwv.selector < 256; dwv.selector++)
+      if (IOConnectCallStructMethod(dwv.conn, dwv.selector, probe, sizeof(probe), NULL, NULL) == KERN_SUCCESS)
+         break;
+   const struct droidvm_virtgpu_getparam param = {DROIDVM_VIRTGPU_PARAM_DEFAULT_3D};
+   struct droidvm_virtgpu_getparam_reply reply = {};
+   if (dwv.selector < 256 &&
+       vg_call(DROIDVM_VIRTGPU_GETPARAM, &param, sizeof(param), &reply, sizeof(reply)) == KERN_SUCCESS)
+      answer = reply.value == 1;
+   IOServiceClose(dwv.conn);
+   dwv.conn = IO_OBJECT_NULL;
+   return answer;
+}
+
+/* TU_DARWIN_VIRTGPU=1 or 0 chooses the backend; unset, the board does (dwv_board_default). */
+bool
+dwv_enabled(void)
+{
+   const char *text = getenv("TU_DARWIN_VIRTGPU");
+   if (text && *text)
+      return strcmp(text, "0") != 0;
+   return dwv_board_default();
+}
+
+static kern_return_t
+vg_call(uint32_t op, const void *in, size_t in_size, void *out, size_t out_size)
+{
+   uint8_t stack[512];
+   uint8_t *buffer = in_size + 8 <= sizeof(stack) ? stack : (uint8_t *)malloc(in_size + 8);
+   if (!buffer)
+      return kIOReturnNoMemory;
+   const uint32_t header[2] = {DWV_TUNNEL_MAGIC, DROIDVM_VIRTGPU_METHOD + op};
+   memcpy(buffer, header, sizeof(header));
+   if (in_size)
+      memcpy(buffer + 8, in, in_size);
+   size_t out_bytes = out_size;
+   kern_return_t kr = IOConnectCallStructMethod(dwv.conn, dwv.selector, buffer, in_size + 8, out_size ? out : NULL,
+                                                out_size ? &out_bytes : NULL);
+   if (buffer != stack)
+      free(buffer);
+   return kr;
+}
+
+/* One ccmd through EXECBUFFER (no fence), its response in the shmem: the response's length is written first (the host copies back
+ * at most that much), then the host's seqno must reach the request's. Called with the lock held. */
+static kern_return_t
+vg_ccmd(void *request, uint32_t size, uint32_t response_bytes)
+{
+   uint32_t *header = (uint32_t *)request; /* vdrm_ccmd_req: cmd, len, seqno, rsp_off */
+   header[1] = size;
+   header[2] = ++dwv.seqno;
+   header[3] = 0;
+   const uint32_t response_offset = *(volatile uint32_t *)(dwv.shmem + 4);
+   if (response_bytes)
+      *(volatile uint32_t *)(dwv.shmem + response_offset) = response_bytes;
+   uint8_t stack[512];
+   const size_t total = sizeof(struct droidvm_virtgpu_execbuffer) + size;
+   uint8_t *exec = total <= sizeof(stack) ? stack : (uint8_t *)malloc(total);
+   if (!exec)
+      return kIOReturnNoMemory;
+   const struct droidvm_virtgpu_execbuffer e = {0, 0, size, 0};
+   memcpy(exec, &e, sizeof(e));
+   memcpy(exec + sizeof(e), request, size);
+   struct droidvm_virtgpu_execbuffer_reply reply = {};
+   kern_return_t kr = vg_call(DROIDVM_VIRTGPU_EXECBUFFER, exec, total, &reply, sizeof(reply));
+   if (exec != stack)
+      free(exec);
+   /* The host answers in the same command's processing; this rarely spins at all. */
+   for (unsigned i = 0; kr == KERN_SUCCESS && *(volatile uint32_t *)dwv.shmem < dwv.seqno; i++) {
+      if (i > 100000)
+         return kIOReturnTimeout;
+      if (i > 100)
+         usleep(50);
+   }
+   return kr;
+}
+
+static const volatile uint8_t *
+vg_response(void)
+{
+   return dwv.shmem + *(volatile uint32_t *)(dwv.shmem + 4);
+}
+
+/* An IOCTL_SIMPLE ccmd with a payload the host fills (IOC_INOUT): msm_ccmd_ioctl_simple_rsp is the length, the ioctl's return value,
+ * then the payload. Called with the lock held. */
+static kern_return_t
+vg_ioctl_simple(uint32_t ioctl, void *payload, uint32_t payload_bytes)
+{
+   uint8_t request[16 + 4 + 64] = {};
+   const uint32_t cmd = DWV_CCMD_IOCTL_SIMPLE;
+   memcpy(request, &cmd, 4);
+   memcpy(request + 16, &ioctl, 4);
+   memcpy(request + 20, payload, payload_bytes);
+   kern_return_t kr = vg_ccmd(request, 20 + payload_bytes, 8 + payload_bytes);
+   if (kr != KERN_SUCCESS)
+      return kr;
+   int32_t ret;
+   memcpy(&ret, (const void *)(vg_response() + 4), 4);
+   memcpy(payload, (const void *)(vg_response() + 8), payload_bytes);
+   return ret ? kIOReturnError : KERN_SUCCESS;
+}
+
+static uint64_t
+vg_get_param(uint32_t param, kern_return_t *kr)
+{
+   struct { uint32_t pipe, param; uint64_t value; uint32_t len, pad; } p = {DWV_MSM_PIPE_3D0, param, 0, 0, 0};
+   *kr = vg_ioctl_simple(DWV_MSM_GET_PARAM, &p, sizeof(p));
+   return p.value;
+}
+
+kern_return_t
+dwv_open(void)
+{
+   io_service_t service = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching(dwv_service_name()));
+   if (!service)
+      return kIOReturnNotFound;
+   kern_return_t kr = IOServiceOpen(service, mach_task_self(), DROIDVM_VIRTGPU_OPEN_TYPE, &dwv.conn);
+   IOObjectRelease(service);
+   if (kr != KERN_SUCCESS)
+      return kr;
+   const uint32_t probe[2] = {DWV_TUNNEL_MAGIC, 0xffffffffu};
+   for (dwv.selector = 0; dwv.selector < 256; dwv.selector++)
+      if (IOConnectCallStructMethod(dwv.conn, dwv.selector, probe, sizeof(probe), NULL, NULL) == KERN_SUCCESS)
+         break;
+   if (dwv.selector == 256)
+      kr = kIOReturnNotPermitted;
+
+   pthread_mutex_lock(&dwv.lock);
+   const struct droidvm_virtgpu_get_caps get_caps = {DWV_CAPSET_DRM, 0};
+   if (kr == KERN_SUCCESS)
+      kr = vg_call(DROIDVM_VIRTGPU_GET_CAPS, &get_caps, sizeof(get_caps), &dwv.caps, sizeof(dwv.caps));
+   const struct droidvm_virtgpu_context_init init = {DWV_CAPSET_DRM, 64};
+   struct droidvm_virtgpu_context_init_reply context = {};
+   if (kr == KERN_SUCCESS)
+      kr = vg_call(DROIDVM_VIRTGPU_CONTEXT_INIT, &init, sizeof(init), &context, sizeof(context));
+   /* The msm shmem: a host blob (blob id 0) the host carves from its pool, where it answers ccmds. */
+   const struct droidvm_virtgpu_create_blob shmem = {DROIDVM_VIRTGPU_BLOB_MEM_HOST3D, DROIDVM_VIRTGPU_BLOB_FLAG_MAPPABLE,
+                                                     DWV_SHMEM_BYTES, 0, 0, 0};
+   struct droidvm_virtgpu_create_blob_reply blob = {};
+   if (kr == KERN_SUCCESS)
+      kr = vg_call(DROIDVM_VIRTGPU_CREATE_BLOB, &shmem, sizeof(shmem), &blob, sizeof(blob));
+   const struct droidvm_virtgpu_handle handle = {blob.handle, 0};
+   struct droidvm_virtgpu_map_reply map = {};
+   if (kr == KERN_SUCCESS)
+      kr = vg_call(DROIDVM_VIRTGPU_MAP, &handle, sizeof(handle), &map, sizeof(map));
+   if (kr == KERN_SUCCESS) {
+      dwv.shmem = (volatile uint8_t *)(uintptr_t)map.address;
+      dwv.shmem_handle = blob.handle;
+      dwv.seqno = 0;
+      dwv.va_start = vg_get_param(DWV_MSM_PARAM_VA_START, &kr);
+   }
+   if (kr == KERN_SUCCESS)
+      dwv.va_size = vg_get_param(DWV_MSM_PARAM_VA_SIZE, &kr);
+   /* One submit queue, priority 0: the host's ring 1. Every submission rides it, so its fences are one increasing sequence, as the
+    * NativeAdreno ABI's are. */
+   struct { uint32_t flags, prio, id; } queue = {0, 0, 0};
+   if (kr == KERN_SUCCESS)
+      kr = vg_ioctl_simple(DWV_MSM_SUBMITQUEUE_NEW, &queue, sizeof(queue));
+   if (kr == KERN_SUCCESS) {
+      dwv.queue_id = queue.id;
+      dwv.ring = 1;
+      dwv.submit_fence = 0;
+      dwv.next_blob_id = 1;
+   }
+   pthread_mutex_unlock(&dwv.lock);
+   if (kr != KERN_SUCCESS) {
+      IOServiceClose(dwv.conn);
+      dwv.conn = 0;
+   }
+   return kr;
+}
+
+void
+dwv_close(void)
+{
+   /* Closing the connection ends the context: the kernel drains its submissions and drops every resource. */
+   if (dwv.conn)
+      IOServiceClose(dwv.conn);
+   dwv.conn = 0;
+   dwv.shmem = NULL;
+   pthread_mutex_lock(&dwv.lock);
+   free(dwv.bos);
+   dwv.bos = NULL;
+   dwv.bo_capacity = 0;
+   pthread_mutex_unlock(&dwv.lock);
+}
+
+static struct dwv_bo *
+dwv_lookup(uint64_t handle)
+{
+   return handle && handle < dwv.bo_capacity && dwv.bos[handle].used ? &dwv.bos[handle] : NULL;
+}
+
+/* The lowest free handle: turnip indexes its BOs by handle. */
+static uint32_t
+dwv_new_handle(void)
+{
+   for (uint32_t h = 1; h < dwv.bo_capacity; h++)
+      if (!dwv.bos[h].used)
+         return h;
+   uint32_t capacity = dwv.bo_capacity ? dwv.bo_capacity * 2 : 256;
+   if (capacity > DWV_MAX_BOS)
+      return 0;
+   struct dwv_bo *grown = (struct dwv_bo *)realloc(dwv.bos, capacity * sizeof(*grown));
+   if (!grown)
+      return 0;
+   memset(grown + dwv.bo_capacity, 0, (capacity - dwv.bo_capacity) * sizeof(*grown));
+   uint32_t h = dwv.bo_capacity ? dwv.bo_capacity : 1;
+   dwv.bos = grown;
+   dwv.bo_capacity = capacity;
+   return h;
+}
+
+/* GEM_NEW names the BO's address and blob id; the guest blob that carries it brings the pages: allocated by the kernel, or the
+ * caller's own for a BoImport (VK_EXT_external_memory_host). */
+static kern_return_t
+dwv_create(struct dwv_bo *bo, uint64_t iova)
+{
+   struct gem_new {
+      uint32_t header[4];
+      uint64_t iova, size;
+      uint32_t flags, blob_id;
+   };
+   struct {
+      struct droidvm_virtgpu_create_blob b;
+      struct gem_new ccmd;
+   } request = {};
+   struct {
+      struct droidvm_virtgpu_create_blob_user b;
+      struct gem_new ccmd;
+   } user = {};
+   const uint64_t blob_id = dwv.next_blob_id++;
+   const uint32_t flags = DROIDVM_VIRTGPU_BLOB_FLAG_MAPPABLE | DROIDVM_VIRTGPU_BLOB_FLAG_CREATE_GUEST_HANDLE;
+   struct gem_new *ccmd = bo->user_address ? &user.ccmd : &request.ccmd;
+   ccmd->header[0] = DWV_CCMD_GEM_NEW;
+   ccmd->header[1] = sizeof(*ccmd);
+   ccmd->header[2] = ++dwv.seqno;
+   ccmd->iova = iova;
+   ccmd->size = bo->size;
+   ccmd->flags = DWV_MSM_BO_GUEST_ALLOC | DWV_MSM_BO_CACHED_COHERENT;
+   ccmd->blob_id = (uint32_t)blob_id;
+   struct droidvm_virtgpu_create_blob_reply reply = {};
+   kern_return_t kr;
+   if (bo->user_address) {
+      user.b = (struct droidvm_virtgpu_create_blob_user){bo->user_address, bo->size, blob_id, flags, sizeof(user.ccmd)};
+      kr = vg_call(DROIDVM_VIRTGPU_CREATE_BLOB_USER, &user, sizeof(user), &reply, sizeof(reply));
+   } else {
+      request.b = (struct droidvm_virtgpu_create_blob){DROIDVM_VIRTGPU_BLOB_MEM_HOST3D_GUEST, flags, bo->size, blob_id,
+                                                       sizeof(request.ccmd), 0};
+      kr = vg_call(DROIDVM_VIRTGPU_CREATE_BLOB, &request, sizeof(request), &reply, sizeof(reply));
+   }
+   if (kr != KERN_SUCCESS)
+      return kr;
+   bo->kernel_handle = reply.handle;
+   bo->resource_id = reply.resource_id;
+   bo->iova = iova;
+   return KERN_SUCCESS;
+}
+
+static kern_return_t
+dwv_submit(const NativeAdrenoAbiSubmit *req, NativeAdrenoAbiSubmitReply *reply)
+{
+   if (!req->buffer_count || req->buffer_count > NativeAdrenoAbiMaxBuffers)
+      return kIOReturnBadArgument;
+   struct submit_bo { uint32_t flags, handle; uint64_t presumed; };
+   struct submit_cmd { uint32_t type, submit_idx, submit_offset, size, pad, nr_relocs; uint64_t relocs; };
+   /* msm_ccmd_gem_submit_req: vdrm_ccmd_req, flags, queue_id, nr_bos, nr_cmds, fence (36 bytes), then the bo table and the
+    * commands, packed. */
+   struct {
+      uint32_t header[4];
+      uint32_t flags, queue_id, nr_bos, nr_cmds, fence;
+      struct submit_bo bos[NativeAdrenoAbiMaxBuffers];
+      struct submit_cmd cmds[NativeAdrenoAbiMaxBuffers];
+   } ccmd = {};
+   uint32_t nr_bos = 0;
+   for (uint32_t i = 0; i < req->buffer_count; i++) {
+      const struct dwv_bo *bo = dwv_lookup(req->buffers[i].handle);
+      if (!bo || !bo->resource_id || req->buffers[i].iova < bo->iova ||
+          req->buffers[i].iova + req->buffers[i].bytes > bo->iova + bo->size) {
+         /* Turnip takes the refusal for a lost device; say which buffer of the submission it was. */
+         os_log_error(OS_LOG_DEFAULT, "dwv: submit refused: buffer %u of %u, handle %llu (%s), resource %u, bo iova 0x%llx size 0x%llx, "
+                      "buffer iova 0x%llx bytes 0x%llx, table %u", i, req->buffer_count, (unsigned long long)req->buffers[i].handle,
+                      bo ? "known" : "unknown", bo ? bo->resource_id : 0, bo ? (unsigned long long)bo->iova : 0ull,
+                      bo ? (unsigned long long)bo->size : 0ull, (unsigned long long)req->buffers[i].iova,
+                      (unsigned long long)req->buffers[i].bytes, dwv.bo_capacity);
+         return kIOReturnBadArgument;
+      }
+      uint32_t index = 0;
+      while (index < nr_bos && ccmd.bos[index].handle != bo->resource_id)
+         index++;
+      if (index == nr_bos)
+         ccmd.bos[nr_bos++] = (struct submit_bo){DWV_MSM_SUBMIT_BO_READ | DWV_MSM_SUBMIT_BO_WRITE, bo->resource_id, bo->iova};
+      ccmd.cmds[i] = (struct submit_cmd){DWV_MSM_SUBMIT_CMD_BUF, index, (uint32_t)(req->buffers[i].iova - bo->iova),
+                                         (uint32_t)req->buffers[i].bytes, 0, 0, 0};
+   }
+   uint8_t packed[sizeof(ccmd)];
+   const uint32_t head = 36, bos_bytes = nr_bos * sizeof(struct submit_bo), cmds_bytes = req->buffer_count * sizeof(struct submit_cmd);
+   const uint32_t size = head + bos_bytes + cmds_bytes;
+   ccmd.header[0] = DWV_CCMD_GEM_SUBMIT;
+   ccmd.header[1] = size;
+   ccmd.header[2] = ++dwv.seqno;
+   ccmd.queue_id = dwv.queue_id;
+   ccmd.nr_bos = nr_bos;
+   ccmd.nr_cmds = req->buffer_count;
+   ccmd.fence = ++dwv.submit_fence;
+   memcpy(packed, &ccmd, head);
+   memcpy(packed + head, ccmd.bos, bos_bytes);
+   memcpy(packed + head + bos_bytes, ccmd.cmds, cmds_bytes);
+   uint8_t exec[sizeof(struct droidvm_virtgpu_execbuffer) + sizeof(packed)];
+   const struct droidvm_virtgpu_execbuffer e = {DROIDVM_VIRTGPU_EXEC_FENCE, dwv.ring, size, 0};
+   memcpy(exec, &e, sizeof(e));
+   memcpy(exec + sizeof(e), packed, size);
+   struct droidvm_virtgpu_execbuffer_reply fenced = {};
+   kern_return_t kr = vg_call(DROIDVM_VIRTGPU_EXECBUFFER, exec, sizeof(e) + size, &fenced, sizeof(fenced));
+   if (kr == KERN_SUCCESS)
+      reply->fence = fenced.fence;
+   return kr;
+}
+
+kern_return_t
+dwv_map(uint64_t handle, void **address, uint64_t *bytes)
+{
+   pthread_mutex_lock(&dwv.lock);
+   const struct dwv_bo *bo = dwv_lookup(handle);
+   const struct droidvm_virtgpu_handle request = {bo ? bo->kernel_handle : 0, 0};
+   pthread_mutex_unlock(&dwv.lock);
+   if (!bo || !request.handle)
+      return kIOReturnBadArgument;
+   struct droidvm_virtgpu_map_reply reply = {};
+   kern_return_t kr = vg_call(DROIDVM_VIRTGPU_MAP, &request, sizeof(request), &reply, sizeof(reply));
+   if (kr == KERN_SUCCESS) {
+      *address = (void *)(uintptr_t)reply.address;
+      *bytes = reply.size;
+   }
+   return kr;
+}
+
+/* TU_DARWIN_VIRTGPU_TRACE=1: one stderr line per BO call and its result. */
+static bool
+dwv_trace(void)
+{
+   static int trace = -1;
+   if (trace < 0) {
+      const char *value = getenv("TU_DARWIN_VIRTGPU_TRACE");
+      trace = value && *value == '1';
+   }
+   return trace;
+}
+
+static kern_return_t dwv_call_locked(uint32_t method, const void *in, size_t in_size, void *out, size_t out_size);
+
+kern_return_t
+dwv_call(uint32_t method, const void *in, size_t in_size, void *out, size_t out_size)
+{
+   kern_return_t kr = dwv_call_locked(method, in, in_size, out, out_size);
+   if (kr != KERN_SUCCESS && kr != kIOReturnBusy && kr != kIOReturnTimeout)
+      os_log_error(OS_LOG_DEFAULT, "dwv: method %u (in %zu, out %zu) failed: 0x%x", method, in_size, out_size, kr);
+   if (dwv_trace() && (method == NativeAdrenoMethodBoImport || kr != KERN_SUCCESS)) {
+      const uint64_t *words = (const uint64_t *)in;
+      fprintf(stderr, "tu-virtgpu: method %u in %zu [%#llx %#llx] -> 0x%x\n", method, in_size,
+              in_size >= 8 ? (unsigned long long)words[0] : 0ull, in_size >= 16 ? (unsigned long long)words[1] : 0ull, kr);
+   }
+   return kr;
+}
+
+static kern_return_t
+dwv_call_locked(uint32_t method, const void *in, size_t in_size, void *out, size_t out_size)
+{
+   kern_return_t kr = KERN_SUCCESS;
+   switch (method) {
+   case NativeAdrenoMethodQuery: {
+      if (out_size != sizeof(NativeAdrenoAbiParams))
+         return kIOReturnBadArgument;
+      NativeAdrenoAbiParams *params = (NativeAdrenoAbiParams *)out;
+      *params = (NativeAdrenoAbiParams){NativeAdrenoAbiVersion, 48, 48, NativeAdrenoParamsHostImport,
+                                        1ull << NativeAdrenoAbiMaxBoBytesShift};
+      return KERN_SUCCESS;
+   }
+   case NativeAdrenoMethodGetDeviceInfo: {
+      if (out_size != sizeof(NativeAdrenoAbiDeviceInfo))
+         return kIOReturnBadArgument;
+      NativeAdrenoAbiDeviceInfo *info = (NativeAdrenoAbiDeviceInfo *)out;
+      *info = (NativeAdrenoAbiDeviceInfo){};
+      info->chip_id = (uint32_t)dwv.caps.chip_id;
+      info->gmem_bytes = dwv.caps.gmem_size;
+      info->gmem_base = dwv.caps.gmem_base;
+      info->uche_trap_base = dwv.caps.uche_trap_base;
+      info->va_start = dwv.va_start;
+      info->va_size = dwv.va_size;
+      info->highest_bank_bit = dwv.caps.highest_bank_bit;
+      /* drm2kgsl reports neither (KGSL has no property for them, and its GET_PARAM answers 0); KGSL programs this a7xx part as
+       * msm's sm8650 configuration, UBWC swizzle levels 2 and 3 and eight-channel macrotiles, which droidvm-gpu's driver gives
+       * Turnip too. Another pair misplaces texels wherever the CPU tiles or detiles an image (a host image copy: Core Image's
+       * readbacks had 16-pixel blocks swapped in every other 16-row band). */
+      info->ubwc_swizzle = dwv.caps.ubwc_swizzle ? (uint32_t)dwv.caps.ubwc_swizzle : 6;
+      info->macrotile_mode = dwv.caps.macrotile_mode ? (uint32_t)dwv.caps.macrotile_mode : 1;
+      info->ubwc_version = 4;
+      /* The client picks addresses (GEM_NEW's iova), and the host imports BO pages IO-coherent and write-back. */
+      info->flags = NativeAdrenoDeviceClientIova | (dwv.caps.has_cached_coherent ? NativeAdrenoDeviceCachedCoherent : 0);
+      return KERN_SUCCESS;
+   }
+   case NativeAdrenoMethodGetTimestamp: {
+      if (out_size != sizeof(NativeAdrenoAbiTimestamp))
+         return kIOReturnBadArgument;
+      /* drm2kgsl has no GPU timestamp to give; the always-on counter runs at 19.2 MHz, and this is where it would be. */
+      ((NativeAdrenoAbiTimestamp *)out)->ticks = os_time_get_nano() / 1000 * 192 / 10;
+      return KERN_SUCCESS;
+   }
+   case NativeAdrenoMethodGetStatus: {
+      if (out_size != sizeof(NativeAdrenoAbiStatus) || !dwv.shmem)
+         return kIOReturnBadArgument;
+      /* msm_shmem's async_error (a submission the host refused) and global_faults, when the host's shmem has them. */
+      const uint32_t fields = *(volatile uint32_t *)(dwv.shmem + 4);
+      const uint64_t faults = (fields > 8 ? *(volatile uint32_t *)(dwv.shmem + 8) : 0) +
+                              (fields > 12 ? *(volatile uint32_t *)(dwv.shmem + 12) : 0);
+      *(NativeAdrenoAbiStatus *)out = (NativeAdrenoAbiStatus){faults, 0};
+      return KERN_SUCCESS;
+   }
+   case NativeAdrenoMethodWaitFence: {
+      if (in_size != sizeof(NativeAdrenoAbiWaitFence))
+         return kIOReturnBadArgument;
+      const NativeAdrenoAbiWaitFence *req = (const NativeAdrenoAbiWaitFence *)in;
+      const struct droidvm_virtgpu_wait_fence wait = {dwv.ring, 0, req->fence, req->timeout_ns};
+      return vg_call(DROIDVM_VIRTGPU_WAIT_FENCE, &wait, sizeof(wait), NULL, 0);
+   }
+   case NativeAdrenoMethodCreateQueue:
+      if (out_size == sizeof(NativeAdrenoAbiQueueReply))
+         ((NativeAdrenoAbiQueueReply *)out)->queue = 1;
+      return KERN_SUCCESS;
+   case NativeAdrenoMethodCloseQueue:
+   case NativeAdrenoMethodBoCpuUnmap:
+      return KERN_SUCCESS;
+   case NativeAdrenoMethodBoCpuMap:   /* the backend maps through dwv_map */
+      return kIOReturnUnsupported;
+   default:
+      break;
+   }
+
+   pthread_mutex_lock(&dwv.lock);
+   switch (method) {
+   case NativeAdrenoMethodBoAlloc: {
+      const NativeAdrenoAbiBoAlloc *req = (const NativeAdrenoAbiBoAlloc *)in;
+      if (in_size != sizeof(*req) || out_size != sizeof(NativeAdrenoAbiBoAllocReply) || !req->bytes ||
+          (req->bytes & 4095) || req->bytes > (1ull << NativeAdrenoAbiMaxBoBytesShift)) {
+         kr = kIOReturnBadArgument;
+         break;
+      }
+      uint32_t handle = dwv_new_handle();
+      if (!handle) {
+         kr = kIOReturnNoResources;
+         break;
+      }
+      dwv.bos[handle] = (struct dwv_bo){.used = true, .size = req->bytes};
+      ((NativeAdrenoAbiBoAllocReply *)out)->handle = handle;
+      break;
+   }
+   case NativeAdrenoMethodBoImport: {
+      const NativeAdrenoAbiBoImport *req = (const NativeAdrenoAbiBoImport *)in;
+      if (in_size != sizeof(*req) || out_size != sizeof(NativeAdrenoAbiBoAllocReply) || !req->address || !req->bytes ||
+          ((req->address | req->bytes) & 4095) || req->bytes > (1ull << NativeAdrenoAbiMaxBoBytesShift)) {
+         kr = kIOReturnBadArgument;
+         break;
+      }
+      uint32_t handle = dwv_new_handle();
+      if (!handle) {
+         kr = kIOReturnNoResources;
+         break;
+      }
+      dwv.bos[handle] = (struct dwv_bo){.used = true, .size = req->bytes, .user_address = req->address};
+      ((NativeAdrenoAbiBoAllocReply *)out)->handle = handle;
+      break;
+   }
+   case NativeAdrenoMethodBoMap: {
+      const NativeAdrenoAbiBoMap *req = (const NativeAdrenoAbiBoMap *)in;
+      struct dwv_bo *bo = in_size == sizeof(*req) ? dwv_lookup(req->handle) : NULL;
+      if (!bo || bo->resource_id || out_size != sizeof(NativeAdrenoAbiBoMapReply) || (req->iova & 4095) ||
+          req->iova < dwv.va_start || req->iova + bo->size > dwv.va_start + dwv.va_size) {
+         kr = bo && bo->resource_id ? kIOReturnBusy : kIOReturnBadArgument;
+         break;
+      }
+      kr = dwv_create(bo, req->iova);
+      if (kr == KERN_SUCCESS)
+         ((NativeAdrenoAbiBoMapReply *)out)->iova = req->iova;
+      break;
+   }
+   case NativeAdrenoMethodBoFree: {
+      const NativeAdrenoAbiBoFree *req = (const NativeAdrenoAbiBoFree *)in;
+      struct dwv_bo *bo = in_size == sizeof(*req) ? dwv_lookup(req->handle) : NULL;
+      if (!bo) {
+         kr = kIOReturnBadArgument;
+         break;
+      }
+      if (bo->kernel_handle) {
+         /* The kernel lets the context's submissions finish before the pages go back. */
+         const struct droidvm_virtgpu_handle close = {bo->kernel_handle, 0};
+         kr = vg_call(DROIDVM_VIRTGPU_GEM_CLOSE, &close, sizeof(close), NULL, 0);
+      }
+      if (kr == KERN_SUCCESS)
+         *bo = (struct dwv_bo){};
+      break;
+   }
+   case NativeAdrenoMethodSubmit:
+      kr = in_size == sizeof(NativeAdrenoAbiSubmit) && out_size == sizeof(NativeAdrenoAbiSubmitReply)
+              ? dwv_submit((const NativeAdrenoAbiSubmit *)in, (NativeAdrenoAbiSubmitReply *)out)
+              : kIOReturnBadArgument;
+      break;
+   case NativeAdrenoMethodSetMetadata: {
+      const NativeAdrenoAbiMetadata *req = (const NativeAdrenoAbiMetadata *)in;
+      struct dwv_bo *bo = in_size == sizeof(*req) ? dwv_lookup(req->handle) : NULL;
+      if (!bo || req->bytes > NativeAdrenoAbiMetadataBytes) {
+         kr = kIOReturnBadArgument;
+         break;
+      }
+      bo->metadata_bytes = req->bytes;
+      memcpy(bo->metadata, req->text, req->bytes);
+      break;
+   }
+   case NativeAdrenoMethodGetMetadata: {
+      const NativeAdrenoAbiMetadata *req = (const NativeAdrenoAbiMetadata *)in;
+      const struct dwv_bo *bo = in_size == sizeof(*req) ? dwv_lookup(req->handle) : NULL;
+      if (!bo || out_size != sizeof(NativeAdrenoAbiMetadata)) {
+         kr = kIOReturnBadArgument;
+         break;
+      }
+      NativeAdrenoAbiMetadata *reply = (NativeAdrenoAbiMetadata *)out;
+      *reply = (NativeAdrenoAbiMetadata){.handle = req->handle, .bytes = bo->metadata_bytes};
+      memcpy(reply->text, bo->metadata, bo->metadata_bytes);
+      break;
+   }
+   default:
+      kr = kIOReturnUnsupported;
+      break;
+   }
+   pthread_mutex_unlock(&dwv.lock);
+   return kr;
+}
diff --git a/src/freedreno/vulkan/tu_knl_darwin_virtgpu.h b/src/freedreno/vulkan/tu_knl_darwin_virtgpu.h
new file mode 100644
index 0000000..4f627ff
--- /dev/null
+++ b/src/freedreno/vulkan/tu_knl_darwin_virtgpu.h
@@ -0,0 +1,24 @@
+/*
+ * Turnip's Darwin backend over the guest's virtio GPU (tu_knl_darwin_virtgpu.cc): the NativeAdreno ABI methods tu_knl_darwin.cc
+ * calls, served by a DRM native context (NativeAdreno's virtgpu methods) in the msm protocol of the host's drm2kgsl.
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef TU_KNL_DARWIN_VIRTGPU_H
+#define TU_KNL_DARWIN_VIRTGPU_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <mach/mach.h>
+
+/* TU_DARWIN_VIRTGPU=1 */
+bool dwv_enabled(void);
+/* The DRM context, its msm shmem and its submit queue; closing the connection ends them all. */
+kern_return_t dwv_open(void);
+void dwv_close(void);
+/* One NativeAdreno ABI method, as dw_call would make it. */
+kern_return_t dwv_call(uint32_t method, const void *in, size_t in_size, void *out, size_t out_size);
+/* A BO's CPU view: its guest pages mapped into this task (it lasts until BoFree). */
+kern_return_t dwv_map(uint64_t handle, void **address, uint64_t *bytes);
+
+#endif
