+/* TU_DARWIN_VIRTGPU=1: a DRM native context of the guest's virtio GPU instead of the KGSL proxy; the same facts come back. */
+static VkResult
+dw_open_virtgpu(struct tu_instance *instance)
+{
+   kern_return_t kr = dwv_open();
+   dw.virtgpu = kr == KERN_SUCCESS;
+   if (kr == KERN_SUCCESS)
+      kr = dw_call(NativeAdrenoMethodQuery, NULL, 0, &dw.params, sizeof(dw.params));
+   if (kr == KERN_SUCCESS)
+      kr = dw_call(NativeAdrenoMethodGetDeviceInfo, NULL, 0, &dw.info, sizeof(dw.info));
+   if (kr != KERN_SUCCESS) {
+      if (dw.virtgpu)
+         dwv_close();
+      dw.virtgpu = false;
+      return vk_startup_errorf(instance, VK_ERROR_INITIALIZATION_FAILED, "virtio-gpu DRM context failed: 0x%x", kr);
+   }
+   dw.open = true;
+   dw.inflight_count = 0;
+   dw.last_fence = 0;
+   return VK_SUCCESS;
+}
