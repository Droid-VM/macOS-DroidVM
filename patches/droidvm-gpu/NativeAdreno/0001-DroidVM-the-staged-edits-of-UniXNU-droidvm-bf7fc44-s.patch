From 9f0f8605db0efc80f63d95a313e18a38aac4d69f Mon Sep 17 00:00:00 2001
From: lateautumn233 <lateautumn233@foxmail.com>
Date: Sat, 31 Oct 2026 07:11:23 -0400
Subject: [PATCH 1/3] DroidVM: the staged edits of UniXNU-droidvm bf7fc44's
 scripts/build-droidvm-gpu.py

The clients' windows are offsets from droidvm_gpu_window_base() (the KGSL VBO the host reserved) instead of absolute addresses of
sheng's GPU address space, and there are six of them instead of three (iconservicesagent needs a fourth); setScope() asks about the
old queue range only once the core was scoped (an unscoped core's range 0 is the render server's, so any other open failed busy while
it had a job in flight).
---
 NativeAdrenoPublish.cpp    | 9 ++++++---
 NativeAdrenoUserClient.cpp | 2 +-
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/NativeAdrenoPublish.cpp b/NativeAdrenoPublish.cpp
index 1d74546..5fa7753 100644
--- a/NativeAdrenoPublish.cpp
+++ b/NativeAdrenoPublish.cpp
@@ -19,6 +19,8 @@
 #include <string.h>
 #include <kern/thread.h>
 #include "NativeAdrenoUserClient.h"
+/* DroidVM: the clients' windows start at the VBO (kits/droidvm/DroidVMGpu.cpp). */
+extern "C" uint64_t droidvm_gpu_window_base(void);
 
 extern "C" void proc_selfname(char *, int);
 /* The plugin's telemetry table (rows of text the Metal bridge keeps), sent as markers: 0xC000|row starts a row, 0x8000|(a<<7)|b appends two characters. */
@@ -100,9 +102,10 @@ struct NativeAdrenoAskerRecord native_adreno_metal_askers[12];
 /* GPU address windows inside the board's VA range (GpuPowerProbe gDeviceInfo: 0x20000000..0x80000000 of the 2 GiB aperture). Slot 0 is the
  * render server's (it held the whole 1.5 GiB alone before int-155 and used at most a few hundred MiB); slots 1 and 2 are for other Metal
  * processes. A kernel connection (the board's self-test) maps where it likes and is never scoped. */
-enum : unsigned {NativeAdrenoMaxClients=3};
+enum : unsigned {NativeAdrenoMaxClients=6};
 static const struct {uint64_t start,bytes;} kClientWindows[NativeAdrenoMaxClients]={
-    {0x20000000ull,0x40000000ull},{0x60000000ull,0x10000000ull},{0x70000000ull,0x10000000ull}};
+    {0x20000000ull,0x40000000ull},{0x60000000ull,0x10000000ull},{0x70000000ull,0x10000000ull},
+    {0x80000000ull,0x10000000ull},{0x90000000ull,0x10000000ull},{0xa0000000ull,0x10000000ull}};
 
 namespace {
 void shiftName(char names[3][17]) {
@@ -226,7 +229,7 @@ bool AGXDeviceUserClient::mount(bool kernel)
         if(g.timer)core->attachTimer(g.timer);
         if(g.info)core->attachDeviceInfo(g.info);
         /* Queue ranges: the kernel client keeps range 0 alone (no user slot is live while the board's self-test runs); users get their slot's. */
-        const IOReturn scoped=kernel?kIOReturnSuccess:core->setScope(slot*NativeAdrenoAbiMaxQueues,kClientWindows[slot].start,kClientWindows[slot].bytes);
+        const IOReturn scoped=kernel?kIOReturnSuccess:core->setScope(slot*NativeAdrenoAbiMaxQueues,droidvm_gpu_window_base()+(kClientWindows[slot].start-kClientWindows[0].start),kClientWindows[slot].bytes);
         if(scoped==kIOReturnSuccess) {
             core_=core;core=nullptr;slot_=slot;kernel_=kernel;live_=true;ok=true;
             if(kernel)g.kernel_client=true;else g.slots[slot]=true;
diff --git a/NativeAdrenoUserClient.cpp b/NativeAdrenoUserClient.cpp
index b3dd3b6..ad9fd7c 100644
--- a/NativeAdrenoUserClient.cpp
+++ b/NativeAdrenoUserClient.cpp
@@ -74,7 +74,7 @@ IOReturn NativeAdrenoUserClient::setScope(uint32_t queue_base,uint64_t window_st
     if(queue_base%NativeAdrenoAbiMaxQueues || queue_base>UINT32_MAX-NativeAdrenoAbiMaxQueues || (window_start&4095) || (window_bytes&4095) ||
         (window_bytes && (window_start+window_bytes<window_start || window_start+window_bytes>(UINT64_C(1)<<input_bits_))))
         return kIOReturnBadArgument;
-    if(liveObjects() || submit_->rangeOutstanding(queue_base_,NativeAdrenoAbiMaxQueues) ||
+    if(liveObjects() || (window_bytes_ && submit_->rangeOutstanding(queue_base_,NativeAdrenoAbiMaxQueues)) ||
         submit_->rangeOutstanding(queue_base,NativeAdrenoAbiMaxQueues))return kIOReturnBusy;
     queue_base_=queue_base;window_start_=window_start;window_bytes_=window_bytes;window_peak_=0;
     return kIOReturnSuccess;
