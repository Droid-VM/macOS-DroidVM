+IOReturn NativeAdrenoMemory::allocateUnmapped(size_t bytes,uint64_t limit)
+{
+    vm_page_t list=nullptr;
+    if(vm_page_alloc_list(bytes/4096,0x80 /* KMA_ZERO */,&list)!=KERN_SUCCESS)return kIOReturnNoMemory;
+    pages_=list;bytes_=bytes;prepared_=true;
+    native_adreno_pinned_bytes[1]=native_adreno_pinned_bytes[1]+bytes;
+    IOReturn status=kIOReturnNoMemory;
+    span_capacity_=bytes/4096;
+    spans_=IONewData(NativeAdrenoPhysicalSpan,span_capacity_);
+    if(!spans_)goto failed;
+    {
+        size_t offset=0;
+        for(vm_page_t page=list;page;page=*reinterpret_cast<vm_page_t *>(page),offset+=4096) {   /* vmp_snext, the first word */
+            const uint64_t physical=uint64_t(vm_page_get_phys_page(page))<<12;
+            if(offset>=bytes || !physical || physical>=limit || 4096>limit-physical) {status=kIOReturnUnsupported;goto failed;}
+            if(span_count_ && physical==spans_[span_count_-1].physical+spans_[span_count_-1].bytes)spans_[span_count_-1].bytes+=4096;
+            else spans_[span_count_++]={offset,physical,4096};
+        }
+        if(offset!=bytes) {status=kIOReturnInternalError;goto failed;}
+    }
+    /* The zeroes went through the cacheable aperture: to the point of coherency before a device that does not snoop sees them. */
