From 52bdf635ea4c2c074fab789775e3847da987e92f Mon Sep 17 00:00:00 2001
From: HuJK <gh@hujk.org>
Date: Thu, 29 Oct 2026 13:38:49 +0800
Subject: [PATCH 8/9] ABI: the Query flags upstream's Turnip reads
 (owned-coherent BOs, BO pool pressure)

As upstream's feat/ipados27-gpu-parity defines them (ccf5e91, 127dff2), without its driver changes: this board's 3D runs on
virtio-gpu (open type 0x4149, no GPU core), whose backend reports neither. NativeAdrenoAbiMaxBoBytesShift stays: the virtio-gpu
backend bounds its blobs by it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MmgVbdYzu7uPjUcpLVQMTq
(cherry picked from commit 627836d507ef08037fff2f9b12e9274ba7b2a4f3)
---
 NativeAdrenoABI.h | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/NativeAdrenoABI.h b/NativeAdrenoABI.h
index 966ac70..4fe2785 100644
--- a/NativeAdrenoABI.h
+++ b/NativeAdrenoABI.h
@@ -41,7 +41,9 @@ struct NativeAdrenoAbiParams {
     uint64_t max_bo_bytes;
 };
 enum {
-    NativeAdrenoParamsHostImport = 1  /* BoImport pins the caller's own pages (an IOSurface's) as a BO */
+    NativeAdrenoParamsHostImport = 1,  /* BoImport pins the caller's own pages (an IOSurface's) as a BO */
+    NativeAdrenoParamsOwnedCoherent = 2, /* BOs are cacheable for the CPU and mapped write-back inner-shareable for the GPU (IO coherence): map them with the default cache mode, not write-combined */
+    NativeAdrenoParamsPoolPressure = 4   /* now: the shared BO pool is nearly full or could not serve an allocation lately; give cached BOs back */
 };
 struct NativeAdrenoAbiBoAlloc {
     uint64_t bytes;               /* 4KiB multiple, <= max_bo_bytes */
