+/// Whether the process still maps every page of a copy's `length` bytes at `pages` (writable, or
+/// readable where the system answers that), as the kernel answers now: asked before a copy no use
+/// names is read or written back ([`CopiedBuffers::copy_in`], [`CopiedBuffers::merge_back`]).
+fn mapped(pages: NonNull<u8>, length: usize) -> bool {
+    let start = pages.as_ptr() as u64;
+    let end = start.saturating_add(length as u64);
+    mapped_writable(start, end) || mapped_readable(start, end)
+}
