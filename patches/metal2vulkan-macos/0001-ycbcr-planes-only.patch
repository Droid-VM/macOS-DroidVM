+/// Whether a two-plane YCbCr texture whose planes a function may read in place is made over its
+/// planes alone, without the image of its converted texels and the conversion's staging copy of
+/// the planes: where the process sets `METAL2VULKAN_YCBCR_PLANES_ONLY=1`. A 4096 x 2160 texture's
+/// image and staging are about 100 MiB, and a compositor that makes a texture of each video frame's
+/// surface (WindowServer's lock-screen wallpaper) holds a pool's worth of them; where every slot
+/// that binds it reads its planes in place, none of it is read.
+fn planes_only() -> bool {
+    static PLANES_ONLY: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *PLANES_ONLY.get_or_init(|| {
+        std::env::var("METAL2VULKAN_YCBCR_PLANES_ONLY").is_ok_and(|value| value.trim() == "1")
+    })
+}
