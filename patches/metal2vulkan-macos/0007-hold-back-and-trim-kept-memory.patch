+impl crate::Device {
+    /// Keeps no memory for later placements while `on` ([`Memory::held_back`]): the caller turns
+    /// it on as the system reports memory pressure and off as it reports the normal level again.
+    /// Turning it on gives back every kept block now ([`crate::Device::release_kept_memory`]):
+    /// how many blocks went. No Metal counterpart.
+    pub fn hold_back_memory(&self, on: bool) -> usize {
+        lock(&self.shared().memory).held_back = on;
+        if on { self.release_kept_memory() } else { 0 }
+    }
+
+    /// Frees the kept empty pooled blocks that have stayed empty for `idle` or longer, each pool's
+    /// last one included ([`Pool::stale`] keeps that one however long it stays empty): how many
+    /// went. The caller trims as its process idles (`Duration::ZERO`: every kept empty pooled
+    /// block). No Metal counterpart.
+    pub fn trim_kept_memory(&self, idle: std::time::Duration) -> usize {
+        let shared = self.shared();
+        let mut memory = lock(&shared.memory);
+        let now = Instant::now();
+        let blocks: Vec<Block> = (memory.pools.iter_mut())
+            .flat_map(|pool| pool.take_idle(now, idle))
+            .collect();
+        let count = blocks.len();
+        for block in blocks {
+            // SAFETY: nothing is placed in a kept empty block, and no command reads it.
+            drop(unsafe { memory.let_go(shared.vk(), block, FreeCause::KeptStale, None) });
+        }
+        count
+    }
+}
+
+impl<T> Pool<T> {
+    /// Every kept empty pooled block that has stayed empty for `idle` or longer, taken out to be
+    /// freed.
+    fn take_idle(&mut self, now: Instant, idle: std::time::Duration) -> Vec<T> {
+        let idle_blocks: Vec<usize> = (self.blocks.iter().enumerate())
+            .filter_map(|(index, block)| {
+                let block = block.as_ref().filter(|block| block.kept())?;
+                (now.saturating_duration_since(block.emptied?) >= idle).then_some(index)
+            })
+            .collect();
+        idle_blocks
+            .into_iter()
+            .filter_map(|index| self.take(index))
+            .collect()
+    }
+}
