+/*
+ * Bring-up (boot-arg union-hide-lower=1): the owner chain union-mounts the SystemOS volume over the OS volume at "/", so getfsstat
+ * lists two mounts on "/". CoreServices' FileIDTree identifies a volume by the device id of its mount point, which is the upper
+ * mount's for both, and aborts ("volume for device id already exists"). The mount whose root vnode another mount covers is left out
+ * of getfsstat, the way a single volume at "/" looks on a real system.
+ */
+static bool
+virt_union_lower_hidden(mount_t mp, vfs_context_t ctx)
+{
+	uint32_t enabled = 0;
+	vnode_t rvp = NULLVP;
+	bool hidden = false;
+
+	if (!PE_parse_boot_argn("union-hide-lower", &enabled, sizeof(enabled)) || !enabled) {
+		return false;
+	}
+	if (VFS_ROOT(mp, &rvp, ctx) == 0) {
+		hidden = rvp->v_mountedhere != NULL;
+		vnode_put(rvp);
+	}
+	return hidden;
+}
+
