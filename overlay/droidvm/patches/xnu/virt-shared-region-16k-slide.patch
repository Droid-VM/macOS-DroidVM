 /*
+ * A slide info page (16 KiB for the arm64 shared cache) can be larger than the kernel's
+ * PAGE_SIZE (4 KiB here). The data request is then answered one VM page at a time: the
+ * enclosing slide page is gathered into a buffer, slid as a whole, and the requested VM
+ * page is copied out of it. This reads one more page of the backing object.
+ */
+static kern_return_t
+shared_region_pager_read_backing_page(
+	shared_region_pager_t pager,
+	vm_object_offset_t backing_offset,
+	void *buffer,
+	struct vm_object_fault_info *fault_info)
+{
+	vm_object_t     src_top_object = pager->srp_backing_object;
+	vm_object_t     src_page_object;
+	vm_page_t       src_page, top_page;
+	vm_prot_t       prot;
+	kern_return_t   kr;
+	kern_return_t   error_code;
+
+retry:
+	vm_object_lock(src_top_object);
+	vm_object_paging_begin(src_top_object);
+	error_code = 0;
+	prot = VM_PROT_READ;
+	src_page = VM_PAGE_NULL;
+	kr = vm_fault_page(src_top_object, backing_offset, VM_PROT_READ, FALSE, FALSE,
+	    &prot, &src_page, &top_page, NULL, &error_code, FALSE, fault_info);
+	switch (kr) {
+	case VM_FAULT_SUCCESS:
+		break;
+	case VM_FAULT_RETRY:
+		goto retry;
+	case VM_FAULT_MEMORY_SHORTAGE:
+		if (vm_page_wait(fault_info->interruptible)) {
+			goto retry;
+		}
+		return MACH_SEND_INTERRUPTED;
+	case VM_FAULT_INTERRUPTED:
+		return MACH_SEND_INTERRUPTED;
+	case VM_FAULT_SUCCESS_NO_VM_PAGE:
+		vm_object_paging_end(src_top_object);
+		vm_object_unlock(src_top_object);
+		return KERN_MEMORY_ERROR;
+	default:
+		return error_code ? error_code : KERN_MEMORY_ERROR;
+	}
+	src_page_object = VM_PAGE_OBJECT(src_page);
+	bcopy((const char *)phystokv((pmap_paddr_t)VM_PAGE_GET_PHYS_PAGE(src_page) << PAGE_SHIFT), buffer, PAGE_SIZE);
+	PAGE_WAKEUP_DONE(src_page);
+	vm_object_paging_end(src_page_object);
+	vm_object_unlock(src_page_object);
+	if (top_page != VM_PAGE_NULL) {
+		vm_object_lock(src_top_object);
+		VM_PAGE_FREE(top_page);
+		vm_object_paging_end(src_top_object);
+		vm_object_unlock(src_top_object);
+	}
+	return KERN_SUCCESS;
+}
