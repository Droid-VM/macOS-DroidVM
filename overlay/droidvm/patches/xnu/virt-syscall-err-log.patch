--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -29,6 +29,7 @@
 #include <sys/sysproto.h>
 #include <sys/kauth.h>
 #include <sys/bitstring.h>
+#include <kern/startup.h>
 
 #include <security/audit/audit.h>
 
@@ -86,6 +87,8 @@
  *
  * Outputs:	none
  */
+TUNABLE(bool, virt_syscall_err_log, "syscall-err-log", false);
+
 void
 unix_syscall(
 	struct arm_saved_state * state,
@@ -185,6 +188,26 @@
 skip_syscall:
 #endif /* CONFIG_MACF */
 
+	if (__improbable(virt_syscall_err_log) && error != 0 && error != ERESTART && error != EJUSTRETURN &&
+	    error != EWOULDBLOCK && code < 1024 && error < 128) {
+		/* first failure of each (syscall, errno) pair, per boot */
+		static uint8_t virt_syscall_err_seen[1024 * 128 / 8];
+		unsigned bit = code * 128 + (unsigned)error;
+		if (!(virt_syscall_err_seen[bit / 8] & (1u << (bit % 8)))) {
+			virt_syscall_err_seen[bit / 8] |= (uint8_t)(1u << (bit % 8));
+			printf("syscall-err: pid %d %s syscall %d errno %d\n", proc_pid(proc), proc->p_comm, code, error);
+			if (code == 57 /* symlink */ || code == 5 /* open */) {
+				char virt_a[96] = "?", virt_b[96] = "";
+				size_t virt_len;
+				(void)copyinstr((user_addr_t)uthread->uu_arg[0], virt_a, sizeof(virt_a), &virt_len);
+				if (code == 57) {
+					(void)copyinstr((user_addr_t)uthread->uu_arg[1], virt_b, sizeof(virt_b), &virt_len);
+				}
+				printf("syscall-err:   arg0 '%s' arg1 '%s'\n", virt_a, virt_b);
+			}
+		}
+	}
+
 	unix_syscall_kprintf("code %d, error %d, results %x, %x (pid %d - %s, tid %lld)\n", code, error,
 	    uthread->uu_rval[0], uthread->uu_rval[1],
 	    pid, get_bsdtask_info(current_task()) ? proc->p_comm : "unknown", thread_tid(current_thread()));
