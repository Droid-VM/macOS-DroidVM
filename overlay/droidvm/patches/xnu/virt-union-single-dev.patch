+/*
+ * Bring-up (boot-arg union-hide-lower=1): the owner chain union-mounts the SystemOS volume over the OS volume at "/", so files under "/"
+ * come from two APFS volumes with two device ids. CoreServices expects one device per mount point and aborts on a device id that no
+ * mount lists. The mount whose root vnode another mount covers reports the covering mount's device id and statfs.
+ */
+mount_t
+virt_union_top(mount_t mp)
+{
+	uint32_t enabled = 0;
+	vnode_t rvp = NULLVP;
+	mount_t top = mp;
+
+	if (mp == NULL || !PE_parse_boot_argn("union-hide-lower", &enabled, sizeof(enabled)) || !enabled) {
+		return mp;
+	}
+	if (VFS_ROOT(mp, &rvp, vfs_context_current()) == 0) {
+		if (rvp->v_mountedhere != NULL) {
+			top = rvp->v_mountedhere;
+		}
+		vnode_put(rvp);
+	}
+	return top;
+}
