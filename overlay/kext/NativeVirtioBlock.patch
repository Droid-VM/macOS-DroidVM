--- a/NativeVirtioBlock.cpp
+++ b/NativeVirtioBlock.cpp
@@ -159,7 +159,7 @@ bool NativeVirtioBlock::reset()
   online = false;
   write32(0x70, 0);
   uint64_t deadline;
-  clock_interval_to_deadline(1000, kMillisecondScale, &deadline);
+  clock_interval_to_deadline(30000, kMillisecondScale, &deadline);
   while (read32(0x70)) {
