@@ -42,6 +42,7 @@ along with Darling.  If not, see <http://www.gnu.org/licenses/>.
 #include <sys/ptrace.h>
 #include <pthread.h>
 #include <sys/utsname.h>
+#include <sys/personality.h>
 
 #ifndef PAGE_SIZE
 #	define PAGE_SIZE	4096
@@ -108,6 +109,28 @@ static int kernel_minor = -1;
 
 int main(int argc, char** argv, char** envp)
 {
+    // Linux ASLR can place its native stack (or its guard gap) over Darling's
+    // fixed commpage/Mach stack. Re-exec before consuming argv, special env or
+    // lifetime FDs. This is a deterministic layout change, never a tool retry.
+    if (!commpage_and_stack_available(sizeof(void*) == 8)) {
+        int current = personality(0xffffffffUL);
+        if (current == -1) {
+            perror("Cannot read mldr personality");
+            return 1;
+        }
+        if (current & ADDR_NO_RANDOMIZE) {
+            fprintf(stderr, "Darling address space unavailable even without ASLR\n");
+            return 1;
+        }
+        if (personality(current | ADDR_NO_RANDOMIZE) == -1) {
+            perror("Cannot disable ASLR for conflicting mldr layout");
+            return 1;
+        }
+        execve("/proc/self/exe", argv, envp);
+        perror("Cannot re-exec mldr with a compatible layout");
+        return 1;
+    }
+
 	void** sp;
 	int pushCount = 0;
 	char *filename, *p = NULL;
