diff --git a/src/startup/mldr/commpage.c b/src/startup/mldr/commpage.c
index d9a7aea..e8eadcd 100644
--- a/src/startup/mldr/commpage.c
+++ b/src/startup/mldr/commpage.c
@@ -20,6 +20,23 @@ static uint64_t get_cpu_caps(void);
 
 #define CGET(p) (commpage + ((p)-_COMM_PAGE_START_ADDRESS))
 
+// Use a hint, not MAP_FIXED: Linux must also honor the native stack guard gap.
+// Probe both the initial Mach stack and commpage before loading any Mach images.
+bool commpage_and_stack_available(bool _64bit)
+{
+    size_t stack_size = 16 * 4096;
+    size_t size = stack_size + (_64bit ? _COMM_PAGE64_AREA_LENGTH : _COMM_PAGE32_AREA_LENGTH);
+    void* wanted = (void*)(commpage_address(_64bit) - stack_size);
+    void* mapping = mmap(wanted, size, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (mapping == MAP_FAILED) {
+        perror("Cannot probe Darling address space");
+        exit(1);
+    }
+    bool available = mapping == wanted;
+    munmap(mapping, size);
+    return available;
+}
+
 void commpage_setup(bool _64bit)
 {
 	uint8_t* commpage;
@@ -41,6 +58,11 @@ void commpage_setup(bool _64bit)
 		exit(1);
 	}
 
+    if (commpage != (void*)commpage_address(_64bit)) {
+        fprintf(stderr, "Darling commpage mapped at an unexpected address\n");
+        exit(1);
+    }
+
 	signature = (char*)CGET(_COMM_PAGE_SIGNATURE);
 	version = (uint16_t*)CGET(_COMM_PAGE_VERSION);
 	cpu_caps64 = (uint64_t*)CGET(_COMM_PAGE_CPU_CAPABILITIES64);
